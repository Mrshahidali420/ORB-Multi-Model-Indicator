var bool  _nfpToday   = false   // reset daily — true if NFP released this session
var float _lastCpiMoM = 0.0     // NOT reset daily — direction of last CPI reading
var float _lastNfpMoM = 0.0     // NOT reset daily — direction of last NFP reading

// ============================================================
// SECTION 4 — TECHNICAL INDICATORS (global scope)
// ============================================================

atr14  = ta.atr(i_atrLen)
volAvg = ta.sma(volume, i_volAvgLen)
rvol   = volume / volAvg
rsi14   = ta.rsi(close, 14)
vwapVal = ta.vwap(hlc3)

// ── NON-REPAINTING DATA ───────────────────────────────────────
// Every higher-TF request uses the confirmed-bar idiom: expr[1] + lookahead_on.
// That returns the value of the last COMPLETED higher-TF bar and is identical
// on historical and realtime bars — live signals match the backtest exactly.

// HTF data — must be at global scope
htfClose = request.security(syminfo.tickerid, i_htfTF, close[1],             lookahead=barmerge.lookahead_on)
htfEma20 = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
htfEma50 = request.security(syminfo.tickerid, i_htfTF, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)

// Daily data — previous-day values are confirmed at day open and stable all session.
// dOpen takes TODAY's open: it is fixed on the first bar of the day, so lookahead_on is leak-free.
dOpen    = request.security(syminfo.tickerid, "D", open,     lookahead=barmerge.lookahead_on)
pdHigh   = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
pdLow    = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
pdClose  = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// ── Reference TF routing ──────────────────────────────────────
// request.security cannot reliably sample a LOWER timeframe than the chart, so
// when a configured reference TF is ≤ the chart TF the chart's own bars are
// used directly (signals then evaluate on every chart bar close). A warning is
// shown on the chart when the chart TF is strictly higher (Section 20B).
_refUseChart  = timeframe.in_seconds(i_refTF)      <= timeframe.in_seconds(timeframe.period)
_fastUseChart = timeframe.in_seconds(i_refTF_fast) <= timeframe.in_seconds(timeframe.period)

// ── Primary Reference TF data (M3/M4/M6/M7/M9, M10 Phase 1) ──────────────────
// On the FIRST chart bar of each new ref-TF period, ref_close is the confirmed
// close of the ref bar that just completed — on historical AND realtime bars.
ref_close   = _refUseChart ? close        : request.security(syminfo.tickerid, i_refTF, close[1],                                  lookahead=barmerge.lookahead_on)
ref_close1  = _refUseChart ? close[1]     : request.security(syminfo.tickerid, i_refTF, close[2],                                  lookahead=barmerge.lookahead_on)
ref_high    = _refUseChart ? high         : request.security(syminfo.tickerid, i_refTF, high[1],                                   lookahead=barmerge.lookahead_on)
ref_low     = _refUseChart ? low          : request.security(syminfo.tickerid, i_refTF, low[1],                                    lookahead=barmerge.lookahead_on)
ref_atr14   = _refUseChart ? atr14        : request.security(syminfo.tickerid, i_refTF, ta.atr(i_atrLen)[1],                       lookahead=barmerge.lookahead_on)
ref_rsi14   = _refUseChart ? rsi14        : request.security(syminfo.tickerid, i_refTF, ta.rsi(close, 14)[1],                      lookahead=barmerge.lookahead_on)
ref_vwap    = _refUseChart ? vwapVal      : request.security(syminfo.tickerid, i_refTF, ta.vwap(hlc3)[1],                          lookahead=barmerge.lookahead_on)
ref_rvol    = _refUseChart ? rvol         : request.security(syminfo.tickerid, i_refTF, (volume / ta.sma(volume, i_volAvgLen))[1], lookahead=barmerge.lookahead_on)
ref_bullBar = _refUseChart ? close > open : request.security(syminfo.tickerid, i_refTF, (close > open)[1],                         lookahead=barmerge.lookahead_on)
ref_bearBar = _refUseChart ? close < open : request.security(syminfo.tickerid, i_refTF, (close < open)[1],                         lookahead=barmerge.lookahead_on)
ref_time    = _refUseChart ? time         : request.security(syminfo.tickerid, i_refTF, time[1],                                   lookahead=barmerge.lookahead_on)

// New ref-TF bar detected: fires on the FIRST chart bar after a ref-TF bar completes.
// When the ref TF resolves to the chart TF, ref_time is the chart bar time → edge fires every bar.
_refEdge = ref_time != ref_time[1]

// ── Fast Reference TF data (M1 Crabel, Combined mode, M10 Phase 2/3) ──────────
fast_close   = _fastUseChart ? close        : request.security(syminfo.tickerid, i_refTF_fast, close[1],                                  lookahead=barmerge.lookahead_on)
fast_close1  = _fastUseChart ? close[1]     : request.security(syminfo.tickerid, i_refTF_fast, close[2],                                  lookahead=barmerge.lookahead_on)
fast_high    = _fastUseChart ? high         : request.security(syminfo.tickerid, i_refTF_fast, high[1],                                   lookahead=barmerge.lookahead_on)
fast_low     = _fastUseChart ? low          : request.security(syminfo.tickerid, i_refTF_fast, low[1],                                    lookahead=barmerge.lookahead_on)
fast_atr14   = _fastUseChart ? atr14        : request.security(syminfo.tickerid, i_refTF_fast, ta.atr(i_atrLen)[1],                       lookahead=barmerge.lookahead_on)
fast_vwap    = _fastUseChart ? vwapVal      : request.security(syminfo.tickerid, i_refTF_fast, ta.vwap(hlc3)[1],                          lookahead=barmerge.lookahead_on)
fast_rvol    = _fastUseChart ? rvol         : request.security(syminfo.tickerid, i_refTF_fast, (volume / ta.sma(volume, i_volAvgLen))[1], lookahead=barmerge.lookahead_on)
fast_rsi14   = _fastUseChart ? rsi14        : request.security(syminfo.tickerid, i_refTF_fast, ta.rsi(close, 14)[1],                      lookahead=barmerge.lookahead_on)
fast_bullBar = _fastUseChart ? close > open : request.security(syminfo.tickerid, i_refTF_fast, (close > open)[1],                         lookahead=barmerge.lookahead_on)
fast_bearBar = _fastUseChart ? close < open : request.security(syminfo.tickerid, i_refTF_fast, (close < open)[1],                         lookahead=barmerge.lookahead_on)
fast_time    = _fastUseChart ? time         : request.security(syminfo.tickerid, i_refTF_fast, time[1],                                   lookahead=barmerge.lookahead_on)

_fastEdge = fast_time != fast_time[1]

// ── DXY data — inverse correlation scoring (confirmed bars) ──
dxy_close = request.security(i_dxy_sym, i_dxy_tf, close[1],             lookahead=barmerge.lookahead_on)
dxy_ema20 = request.security(i_dxy_sym, i_dxy_tf, ta.ema(close, 20)[1], lookahead=barmerge.lookahead_on)
dxy_ema50 = request.security(i_dxy_sym, i_dxy_tf, ta.ema(close, 50)[1], lookahead=barmerge.lookahead_on)

// ── Economic indicators — CPI & NFP for Gold market context ──
// Always run (Pine v6 requirement); i_news_on + _isGoldChart gate display only.
econ_cpi = request.security("ECONOMICS:USCPI", "D", close, lookahead=barmerge.lookahead_off)
econ_nfp = request.security("ECONOMICS:USNFP", "D", close, lookahead=barmerge.lookahead_off)

// Auto-disable DXY on non-Gold charts (XAU* pairs and GOLD ticker variants)
_isGoldChart = syminfo.basecurrency == "XAU"
             or str.contains(str.upper(syminfo.ticker), "XAU")
             or str.contains(str.upper(syminfo.ticker), "GOLD")
_dxyActive   = i_dxy_on and _isGoldChart

// Economic release detection — ta.change() is non-zero only on the bar the value updates
_cpiMoM = ta.change(econ_cpi)
_nfpMoM = ta.change(econ_nfp)
if not na(_cpiMoM) and _cpiMoM != 0
    _cpiToday   := true
    _lastCpiMoM := _cpiMoM
if not na(_nfpMoM) and _nfpMoM != 0
    _nfpToday   := true
    _lastNfpMoM := _nfpMoM

// OR width gates — true = OR is narrow enough to trade, false = skip all signals
// Pass-through when filter is disabled, or when ATR/OR levels are not yet available
_or5WidthOK      = not i_orWidthFilter or na(ref_atr14) or na(_or5H)      or na(_or5L)      or (_or5H      - _or5L)      <= i_orWidthMaxATR * ref_atr14
_or15WidthOK     = not i_orWidthFilter or na(ref_atr14) or na(_or15H)     or na(_or15L)     or (_or15H     - _or15L)     <= i_orWidthMaxATR * ref_atr14
_orCrabelWidthOK = not i_orWidthFilter or na(ref_atr14) or na(_orCrabelH) or na(_orCrabelL) or (_orCrabelH - _orCrabelL) <= i_orWidthMaxATR * ref_atr14

// Gate booleans for all-model DXY filter — true = allow signal, false = suppress
// na-safe: pass-through when DXY data unavailable
_dxyBullGate = not _dxyActive or not i_dxy_gate_models or na(dxy_close) or na(dxy_ema20) or dxy_close < dxy_ema20
_dxyBearGate = not _dxyActive or not i_dxy_gate_models or na(dxy_close) or na(dxy_ema20) or dxy_close > dxy_ema20

// ============================================================
// SECTION 5 — SESSION HELPERS
// ============================================================

f_inSession(sess) =>
    not na(time(timeframe.period, sess, NY_TZ))

inNYSession = f_inSession(i_sessionOpen)
nyHour      = hour(time, NY_TZ)
nyMin       = minute(time, NY_TZ)
pastCutoff  = nyHour >= i_timeCutoff

in5MinOR   = f_inSession(OR_5MIN_STR)
in15MinOR  = f_inSession(OR_15MIN_STR)
inCrabelOR = f_inSession(crabelSessionStr)

// Prime window: first 30 min of NY session (9:30–10:00 EST) — highest-probability ORB window
_primeWindow = inNYSession and nyHour == 9

// ============================================================
// SECTION 6 — DAY DETECTION & DAILY RESET
// ============================================================

// Unique day ID: YYYYMMDD using NY timezone
currentDay = year(time, NY_TZ) * 10000 + month(time, NY_TZ) * 100 + dayofmonth(time, NY_TZ)
_newDay   := currentDay != _lastDay

if _newDay
    _lastDay := currentDay

    // Snapshot previous day OHLC
    _pdHigh  := pdHigh
    _pdLow   := pdLow
    _pdClose := pdClose

    // Rolling ranges of COMPLETED days for NR7/NR4 — push yesterday's confirmed range.
    // Never uses today's developing range, so NR status is stable all session (no repaint).
    prevDayRange = pdHigh - pdLow
    if not na(prevDayRange) and prevDayRange > 0
        array.push(_dailyRanges, prevDayRange)
        if array.size(_dailyRanges) > 7
            array.shift(_dailyRanges)

    // Reset all OR tracking
    _or5H             := na
    _or5L             := na
    _or5Complete      := false
    _or15H            := na
    _or15L            := na
    _or15Complete     := false
    _or15Vol          := 0.0
    _or15RVOL         := na
    _or15Open         := na
    _or15CloseLast    := na
    _or15Dir          := 0
    _lossesToday      := 0
    _orCrabelH        := na
    _orCrabelL        := na
    _orCrabelComplete := false

    // Reset FVG state
    _fvgTop        := na
    _fvgBot        := na
    _fvgBull       := false
    _fvgBear       := false
    _fvgTriggered  := false
    _fvgFormedBar  := -1

    // Reset model state
    _m9BullBreak  := false
    _m9BearBreak  := false
    _m9InsideCount := 0
    _m9FiredBull  := false
    _m9FiredBear  := false

    // Reset OR box drawn flag
    _or15BoxDrawn := false

    // Reset persistent dashboard signal state for new day
    for _ri = 0 to 10
        array.set(_dashSignal, _ri, 0)
        array.set(_lastScore,  _ri, 0)

    // Reset per-day fired flags
    _m1FiredBull := false
    _m1FiredBear := false
    _m3FiredBull := false
    _m3FiredBear := false
    _m4FiredBull := false
    _m4FiredBear := false
    _m7FiredBull := false
    _m7FiredBear := false
    // M10 BDM ORB reset
    _bdmBullBreak      := false
    _bdmBullRetest     := false
    _bdmFiredBull      := false
    _bdmBullBreakLevel := na
    _bdmBullWaitBars   := 0
    line.delete(_bdmBullRetestLine)
    _bdmBullRetestLine := na
    _bdmBearBreak      := false
    _bdmBearRetest     := false
    _bdmFiredBear      := false
    _bdmBearBreakLevel := na
    _bdmBearWaitBars   := 0
    line.delete(_bdmBearRetestLine)
    _bdmBearRetestLine := na

    // Reset Combined pending state
    _combLongFired  := false
    _combShortFired := false

    // Reset economic event "released today" flags
    _cpiToday := false
    _nfpToday := false

// Reset per-bar agreement counters
_agreeCountBull := 0
_agreeCountBear := 0

// Reset all signal flags each bar
sig_m1_bull   := false
sig_m1_bear   := false
sig_m3_bull   := false
sig_m3_bear   := false
sig_m4_bull   := false
sig_m4_bear   := false
sig_m6_bull   := false
sig_m6_bear   := false
sig_m7_bull   := false
sig_m7_bear   := false
sig_m9_bull   := false
sig_m9_bear   := false
sig_m10_bull  := false
sig_m10_bear  := false
sig_comb_bull := false
sig_comb_bear := false

// ============================================================
// SECTION 7 — OR RANGE TRACKING
// ============================================================

// 5-min OR
if in5MinOR
    _or5H := na(_or5H) ? high : math.max(_or5H, high)
    _or5L := na(_or5L) ? low  : math.min(_or5L, low)
else if not _or5Complete and not na(_or5H)
    _or5Complete := true

// 15-min OR — also accumulates window volume and the opening-candle direction
if in15MinOR
    _or15H := na(_or15H) ? high : math.max(_or15H, high)
    _or15L := na(_or15L) ? low  : math.min(_or15L, low)
    if na(_or15Open)
        _or15Open := open
    _or15CloseLast := close
    _or15Vol       += nz(volume)
else if not _or15Complete and not na(_or15H)
    _or15Complete := true
    _or15Dir      := _or15CloseLast > _or15Open ? 1 : _or15CloseLast < _or15Open ? -1 : 0
    // OR-window relative volume vs its own 14-day average (the studies' "in play" filter).
    // The average EXCLUDES today; today is pushed after the read.
    _histAvgOR = array.size(_orVolHist) > 0 ? array.avg(_orVolHist) : na
    _or15RVOL := not na(_histAvgOR) and _histAvgOR > 0 and _or15Vol > 0 ? _or15Vol / _histAvgOR : na
    if _or15Vol > 0
        array.push(_orVolHist, _or15Vol)
        if array.size(_orVolHist) > 14
            array.shift(_orVolHist)

// Crabel OR (user-configurable)
if inCrabelOR
    _orCrabelH := na(_orCrabelH) ? high : math.max(_orCrabelH, high)
    _orCrabelL := na(_orCrabelL) ? low  : math.min(_orCrabelL, low)
else if not _orCrabelComplete and not na(_orCrabelH)
    _orCrabelComplete := true

// ============================================================
// SECTION 7B — ENTRY GUARDS (ported from ORB Pro / XAU Pro)
// Composed AFTER OR tracking so same-bar OR direction/RVOL are used.
// All gates pass-through when disabled or when data is unavailable.
// ============================================================

// News-spike guard: a bar with range ≥ 3× ATR is a data candle or flash move —
// spreads widen and first reactions frequently reverse. Stand aside briefly.
_spikeBar = i_newsGuard and not na(atr14) and atr14 > 0 and (high - low) >= 3.0 * atr14
if _spikeBar
    _blockUntilBar := bar_index + i_newsCool
_newsOK = not i_newsGuard or bar_index >= _blockUntilBar

_orRvolOK = i_orRvolMin <= 0 or na(_or15RVOL) or _or15RVOL >= i_orRvolMin
_lossOK   = i_maxLossDay <= 0 or _lossesToday < i_maxLossDay

// Direction-neutral guard bundle (news + window RVOL + daily stop)
_guardOK = _newsOK and _orRvolOK and _lossOK

// Full per-direction entry gates: DXY + guards + optional opening-candle direction.
// M9 uses _guardOK + DXY only — it fades breakouts, so the direction filter is N/A.
_entryGateBull = _dxyBullGate and _guardOK and (not i_dirFilter or _or15Dir == 1)
_entryGateBear = _dxyBearGate and _guardOK and (not i_dirFilter or _or15Dir == -1)

// ============================================================
// SECTION 8 — FVG DETECTION (inline, after 15-min OR completes)
// ============================================================

// Bullish FVG: bar[2].high < bar[0].low — a gap up; zone = [high[2], low]
// Bearish FVG: bar[2].low > bar[0].high — a gap down; zone = [high, low[2]]
if _or15Complete and not _fvgTriggered and inNYSession
    if high[2] < low and not _fvgBull
        _fvgTop       := low
        _fvgBot       := high[2]
        _fvgBull      := true
        _fvgBear      := false
        _fvgFormedBar := bar_index   // record formation bar so signal is blocked this bar
    if low[2] > high and not _fvgBear
        _fvgTop       := low[2]
        _fvgBot       := high
        _fvgBull      := false
        _fvgBear      := true
        _fvgFormedBar := bar_index

// ============================================================
// SECTION 9 — NR7 / NR4 DETECTION (functions)
// ============================================================

// NR7/NR4: the most recent COMPLETED day's range is the narrowest of the last
// N completed days (classic Crabel: trade the day AFTER the narrow-range day).
// Uses confirmed previous-day data only — stable for the whole session,
// identical on historical and realtime bars.
f_isNRn(n) =>
    sz = array.size(_dailyRanges)
    if sz < 2
        false
    else
        lastR  = array.get(_dailyRanges, sz - 1)
        result = true
        for i = 1 to math.min(sz, n) - 1
            if lastR > array.get(_dailyRanges, sz - 1 - i)
                result := false
        result

isNR7 = f_isNRn(7)
isNR4 = f_isNRn(4)

// Volume gate — na-safe: passes when the filter is disabled (mult ≤ 0) or when
// the symbol's feed has no usable volume (rvol = na must not block all signals)
f_volOK(_rvol, _minMult) =>
    _minMult <= 0 or na(_rvol) or _rvol >= _minMult

// ============================================================
// SECTION 10 — DRAWING HELPERS (functions)
// These only push to global arrays — allowed from UDFs
// ============================================================

f_drawSLTP(entryP, slP, tpP, clrEntry, clrSL, clrTP) =>
    if i_showSLTP
        // TP zone: entry → TP (profit zone, semi-transparent)
        _tpBox = box.new(bar_index, tpP, bar_index + 20, entryP,
             bgcolor=color.new(clrTP, 80), border_color=clrTP, border_width=1)
        // SL zone: entry → SL (risk zone, semi-transparent)
        _slBox = box.new(bar_index, entryP, bar_index + 20, slP,
             bgcolor=color.new(clrSL, 80), border_color=clrSL, border_width=1)
        array.push(_boxes, _tpBox)
        array.push(_boxes, _slBox)
        array.push(_trBoxTP, _tpBox)
        array.push(_trBoxSL, _slBox)
        // Solid entry line
        array.push(_lines, line.new(bar_index, entryP, bar_index + 20, entryP,
             color=clrEntry, style=line.style_solid, width=2))
    else
        array.push(_trBoxTP, box(na))
        array.push(_trBoxSL, box(na))

// yMult controls vertical offset so labels from different models don't overlap on the same bar
f_drawLabel(modelName, entryP, slP, tpP, isBull, yMult = 0.6, _score = 0.0) =>
    if i_showLabels
        yOff      = isBull ? low - atr14 * yMult : high + atr14 * yMult
        _grade    = _score >= 80 ? "A" : _score >= 60 ? "B" : _score >= 40 ? "C" : "F"
        scoreLine = _score > 0 ? "\nScore: " + str.tostring(math.round(_score)) + "% [" + _grade + "]" : ""
        _prefix   = _primeWindow ? "★ " : ""
        array.push(_labels, label.new(bar_index, yOff,
             text      = _prefix + modelName +
                         "\nEntry: " + str.tostring(entryP, format.mintick) +
                         "\nSL: "    + str.tostring(slP,    format.mintick) +
                         "\nTP: "    + str.tostring(tpP,    format.mintick) +
                         scoreLine,
             color     = isBull ? i_colBull : i_colBear,
             style     = isBull ? label.style_label_up : label.style_label_down,
             textcolor = color.white,
             size      = size.small))

// Register a new trade: push to tracking arrays + update per-model last-signal state
// modelIdx: 1-9 for M1-M9, 10 for Combined, 11 for M10 BDM (array index = modelIdx - 1)
f_registerTrade(modelIdx, entryP, slP, tpP, isBull) =>
    arrIdx = modelIdx - 1
    array.push(_trEntry,  entryP)
    array.push(_trSL,     slP)
    array.push(_trTP,     tpP)
    array.push(_trModel,  modelIdx)
    array.push(_trDir,    isBull ? 1 : -1)
    array.push(_trStatus, 0)
    array.push(_trBar,    bar_index)
    array.push(_trDay,    year(time, NY_TZ) * 10000 + month(time, NY_TZ) * 100 + dayofmonth(time, NY_TZ))
    array.push(_trExit,   float(na))
    array.set(_lastEntry,  arrIdx, entryP)
    array.set(_lastSL,     arrIdx, slP)
    array.set(_lastTP,     arrIdx, tpP)
    array.set(_lastDir,    arrIdx, isBull ? 1 : -1)
    array.set(_dashSignal, arrIdx, isBull ? 1 : -1)

// ============================================================
// SECTION 11 — OR BOX DRAWING
// ============================================================

// Draw once per day on first bar after 15-min OR completes
// Lines are created with x2 = bar_index; the extension block below advances x2 each bar
// and stops when _or15Complete resets on a new day — so lines never bleed into the next day
if _or15Complete and not _or15BoxDrawn and not na(_or15H) and not na(_or15L)
    _or15BoxDrawn := true
    orMid = (_or15H + _or15L) / 2.0

    if i_showBox
        _orBoxActive := box.new(bar_index, _or15H, bar_index, _or15L,
             bgcolor=i_colOR, border_color=i_colORLine, border_width=1)
        array.push(_boxes, _orBoxActive)
    else
        _orBoxActive := na

    _orHLineActive := line.new(bar_index, _or15H, bar_index, _or15H,
         color=i_colORLine, style=line.style_dashed, width=1)
    _orLLineActive := line.new(bar_index, _or15L, bar_index, _or15L,
         color=i_colORLine, style=line.style_dashed, width=1)
    array.push(_lines, _orHLineActive)
    array.push(_lines, _orLLineActive)

    if i_showMidLine
        _orMidLineActive := line.new(bar_index, orMid, bar_index, orMid,
             color=color.new(i_colORLine, 50), style=line.style_dotted, width=1)
        array.push(_lines, _orMidLineActive)
    else
        _orMidLineActive := na

    // OR level labels
    array.push(_labels, label.new(bar_index, _or15H,
         text="OR H: "+str.tostring(_or15H, format.mintick),
         color=i_colORLine, style=label.style_label_left, textcolor=color.white, size=size.tiny))
    array.push(_labels, label.new(bar_index, _or15L,
         text="OR L: "+str.tostring(_or15L, format.mintick),
         color=i_colORLine, style=label.style_label_left, textcolor=color.white, size=size.tiny))
    if i_showMidLine
        array.push(_labels, label.new(bar_index, orMid,
             text="OR Mid: "+str.tostring(orMid, format.mintick),
             color=color.new(i_colORLine, 50), style=label.style_label_left, textcolor=color.white, size=size.tiny))

// Extend active OR lines to the current bar every bar they're alive
// When _or15Complete resets on a new day, this block doesn't run → lines freeze at day's last bar
if _or15Complete and not na(_orHLineActive)
    line.set_x2(_orHLineActive, bar_index)
    line.set_x2(_orLLineActive, bar_index)
    if not na(_orMidLineActive)
        line.set_x2(_orMidLineActive, bar_index)
    if not na(_orBoxActive)
        box.set_right(_orBoxActive, bar_index)

// ── Per-Model Confluence Score ────────────────────────────────
// Pure function — reads params + global htfEma20/htfEma50. Returns 0–100.
// _rc=close, _rvol=rel-volume, _rvwap=vwap, _rsi=RSI14 — all from model's own TF.
f_modelScore(isBull, _rc, _rvol, _rvwap, _rsi) =>
    vwapPts  = (isBull ? _rc > _rvwap : _rc < _rvwap) ? 25 : 0
    volPts   = na(_rvol) ? 10 : _rvol >= 2.0 ? 25 : _rvol >= 1.5 ? 18 : _rvol >= 1.2 ? 10 : 0
    htfPts   = isBull ? (htfEma20 > htfEma50 ? 20 : 0) : (htfEma20 < htfEma50 ? 20 : 0)
    rsiPts   = isBull ? (_rsi >= 45 and _rsi <= 70 ? 15 : 0)
                      : (_rsi >= 30 and _rsi <= 55 ? 15 : 0)
    agreePts = isBull ? math.max(math.min(_agreeCountBull - 1, 3), 0) * 10
                      : math.max(math.min(_agreeCountBear - 1, 3), 0) * 10
    math.min(vwapPts + volPts + htfPts + rsiPts + agreePts, 100)

// ============================================================
// SECTION 12 — MODEL FUNCTIONS (stateless: M1, M3, M4, M7)
// These only read global state and push to arrays — no scalar writes
// ============================================================

// ── Model 1: Classic Crabel ───────────────────────────────────
// Uses fast TF data (_rc/_rc1/_ratr/_edge) — defaults 1m per CSV backtest (60–67% WR)
f_model1(_firedBull, _firedBear, _rc, _rc1, _ratr, _edge, _rvol, _gateBull, _gateBear) =>
    bull = false
    bear = false
    if _orCrabelComplete and not na(_orCrabelH) and not na(_orCrabelL) and _orCrabelWidthOK
        if _edge and not pastCutoff and inNYSession
            nrPass = i_m1_nr7 ? (isNR7 or isNR4) : true
            volOk  = f_volOK(_rvol, i_m1_volMult)
            if nrPass and volOk
                slDist = _ratr * i_atrMult
                // Bull breakout: entryP = OR breakout level (buy-stop price, TF-consistent).
                // close > _orCrabelH confirms breakout; SL/TP are anchored to the OR level.
                if _rc > _orCrabelH and _rc1 <= _orCrabelH and not _firedBull and _gateBull
                    bull   := true
                    entryP  = _orCrabelH
                    slP     = entryP - slDist
                    tpP     = entryP + slDist * i_m1_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBull, i_colSL, i_colTP)
                    f_drawLabel("M1 Crabel", entryP, slP, tpP, true, 0.6, f_modelScore(true,  _rc, _rvol, fast_vwap, fast_rsi14))
                    f_registerTrade(1, entryP, slP, tpP, true)
                // Bear breakdown
                if _rc < _orCrabelL and _rc1 >= _orCrabelL and not _firedBear and _gateBear
                    bear   := true
                    entryP  = _orCrabelL
                    slP     = entryP + slDist
                    tpP     = entryP - slDist * i_m1_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBear, i_colSL, i_colTP)
                    f_drawLabel("M1 Crabel", entryP, slP, tpP, false, 0.6, f_modelScore(false, _rc, _rvol, fast_vwap, fast_rsi14))
                    f_registerTrade(1, entryP, slP, tpP, false)
    [bull, bear]

// ── Model 3: 5-Min Scalper ────────────────────────────────────
// Uses primary TF data — defaults 5m per CSV backtest (71–85% WR)
f_model3(_firedBull, _firedBear, _rc, _rc1, _ratr, _edge, _rvol, _rvwap, _gateBull, _gateBear) =>
    bull = false
    bear = false
    if _or5Complete and not na(_or5H) and not na(_or5L) and _or5WidthOK
        if _edge and not pastCutoff and inNYSession
            volOk  = f_volOK(_rvol, i_m3_volMult)
            slDist = _ratr * i_atrMult
            if _rc > _or5H and _rc1 <= _or5H and volOk and _rc > _rvwap and not _firedBull and _gateBull
                bull   := true
                entryP  = _or5H
                slP     = entryP - slDist
                tpP     = entryP + slDist * i_m3_rratio
                f_drawSLTP(entryP, slP, tpP, i_colBull, i_colSL, i_colTP)
                f_drawLabel("M3 5min", entryP, slP, tpP, true, 2.2, f_modelScore(true,  _rc, _rvol, _rvwap, ref_rsi14))
                f_registerTrade(3, entryP, slP, tpP, true)
            if _rc < _or5L and _rc1 >= _or5L and volOk and _rc < _rvwap and not _firedBear and _gateBear
                bear   := true
                entryP  = _or5L
                slP     = entryP + slDist
                tpP     = entryP - slDist * i_m3_rratio
                f_drawSLTP(entryP, slP, tpP, i_colBear, i_colSL, i_colTP)
                f_drawLabel("M3 5min", entryP, slP, tpP, false, 2.2, f_modelScore(false, _rc, _rvol, _rvwap, ref_rsi14))
                f_registerTrade(3, entryP, slP, tpP, false)
    [bull, bear]

// ── Model 4: Standard 15-Min ──────────────────────────────────
// Uses primary TF data — RSI also from primary TF
f_model4(_firedBull, _firedBear, _rc, _rc1, _ratr, _edge, _rvol, _rvwap, _rrsi, _gateBull, _gateBear) =>
    bull = false
    bear = false
    if _or15Complete and not na(_or15H) and not na(_or15L) and _or15WidthOK
        if _edge and not pastCutoff and inNYSession
            volOk   = f_volOK(_rvol, i_m4_volMult)
            htfBull = htfClose > htfEma20 and htfEma20 > htfEma50
            htfBear = htfClose < htfEma20 and htfEma20 < htfEma50
            slDist  = _ratr * i_atrMult
            if _rc > _or15H and _rc1 <= _or15H and not _firedBull and _gateBull
                if volOk and _rc > _rvwap and _rrsi >= i_m4_rsiMin and _rrsi <= 70 and htfBull
                    bull   := true
                    entryP  = _or15H
                    slP     = entryP - slDist
                    tpP     = entryP + slDist * i_m4_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBull, i_colSL, i_colTP)
                    f_drawLabel("M4 15min", entryP, slP, tpP, true, 3.0, f_modelScore(true,  _rc, _rvol, _rvwap, _rrsi))
                    f_registerTrade(4, entryP, slP, tpP, true)
            if _rc < _or15L and _rc1 >= _or15L and not _firedBear and _gateBear
                if volOk and _rc < _rvwap and _rrsi <= i_m4_rsiMax and _rrsi >= 30 and htfBear
                    bear   := true
                    entryP  = _or15L
                    slP     = entryP + slDist
                    tpP     = entryP - slDist * i_m4_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBear, i_colSL, i_colTP)
                    f_drawLabel("M4 15min", entryP, slP, tpP, false, 3.0, f_modelScore(false, _rc, _rvol, _rvwap, _rrsi))
                    f_registerTrade(4, entryP, slP, tpP, false)
    [bull, bear]

// ── Model 7: Gold ORB ─────────────────────────────────────────
// Uses primary TF data — 5m per CSV backtest (46–48% WR; marginal but included)
f_model7(_firedBull, _firedBear, _rc, _rc1, _ratr, _edge, _rvol, _rvwap, _gateBull, _gateBear) =>
    bull = false
    bear = false
    if _or15Complete and not na(_or15H) and not na(_or15L) and _or15WidthOK
        if _edge and nyHour < i_m7_cutoffHour and inNYSession
            slDist = _ratr * i_atrMult
            volOk  = f_volOK(_rvol, i_m7_volMult)
            orMid7  = (_or15H + _or15L) / 2
            if _rc > _or15H and _rc1 <= _or15H and not _firedBull and volOk and _rc > _rvwap and _gateBull
                bull   := true
                entryP  = _rc                      // confirmed close above OR high
                slP     = orMid7 - slDist          // SL below OR mid + ATR buffer
                riskD   = entryP - slP
                tpP     = entryP + riskD * i_m7_rratio
                f_drawSLTP(entryP, slP, tpP, i_colBull, i_colSL, i_colTP)
                f_drawLabel("M7 Gold", entryP, slP, tpP, true, 2.2, f_modelScore(true,  _rc, _rvol, _rvwap, ref_rsi14))
                f_registerTrade(7, entryP, slP, tpP, true)
            if _rc < _or15L and _rc1 >= _or15L and not _firedBear and volOk and _rc < _rvwap and _gateBear
                bear   := true
                entryP  = _rc                      // confirmed close below OR low
                slP     = orMid7 + slDist          // SL above OR mid + ATR buffer
                riskD   = slP - entryP
                tpP     = entryP - riskD * i_m7_rratio
                f_drawSLTP(entryP, slP, tpP, i_colBear, i_colSL, i_colTP)
                f_drawLabel("M7 Gold", entryP, slP, tpP, false, 2.2, f_modelScore(false, _rc, _rvol, _rvwap, ref_rsi14))
                f_registerTrade(7, entryP, slP, tpP, false)
    [bull, bear]

// ============================================================
// SECTION 13 — RUN STATELESS MODELS (Multi-Model mode)
// ============================================================

// DXY gates are passed INTO the models so a suppressed signal never registers
// a trade, draws SL/TP, or touches the dashboard — gate and visuals stay in sync.
if true
    if i_m1_on
        // M1 uses fast TF (default 1m) — best per CSV backtest
        [b, s] = f_model1(_m1FiredBull, _m1FiredBear, fast_close, fast_close1, fast_atr14, _fastEdge, fast_rvol, _entryGateBull, _entryGateBear)
        sig_m1_bull := b
        sig_m1_bear := s
        if b
            _m1FiredBull    := true
            _agreeCountBull += 1
        if s
            _m1FiredBear    := true
            _agreeCountBear += 1
    if i_m3_on
        // M3 uses primary TF (default 5m) — best per CSV backtest
        [b, s] = f_model3(_m3FiredBull, _m3FiredBear, ref_close, ref_close1, ref_atr14, _refEdge, ref_rvol, ref_vwap, _entryGateBull, _entryGateBear)
        sig_m3_bull := b
        sig_m3_bear := s
        if b
            _m3FiredBull    := true
            _agreeCountBull += 1
        if s
            _m3FiredBear    := true
            _agreeCountBear += 1
    if i_m4_on
        // M4 uses primary TF (default 5m)
        [b, s] = f_model4(_m4FiredBull, _m4FiredBear, ref_close, ref_close1, ref_atr14, _refEdge, ref_rvol, ref_vwap, ref_rsi14, _entryGateBull, _entryGateBear)
        sig_m4_bull := b
        sig_m4_bear := s
        if b
            _m4FiredBull    := true
            _agreeCountBull += 1
        if s
            _m4FiredBear    := true
            _agreeCountBear += 1
    if i_m7_on
        // M7 uses primary TF (default 5m)
        [b, s] = f_model7(_m7FiredBull, _m7FiredBear, ref_close, ref_close1, ref_atr14, _refEdge, ref_rvol, ref_vwap, _entryGateBull, _entryGateBear)
        sig_m7_bull := b
        sig_m7_bear := s
        if b
            _m7FiredBull    := true
            _agreeCountBull += 1
        if s
            _m7FiredBear    := true
            _agreeCountBear += 1

// ============================================================
// SECTION 15 — MODEL 6: FVG ORB (INLINE — stateful)
// ============================================================

if i_m6_on and _or15Complete and not na(_or15H) and not na(_or15L) and _or15WidthOK
    if _refEdge and not pastCutoff and inNYSession and not _fvgTriggered
        orRange  = _or15H - _or15L
        minFvgSz = orRange * i_m6_fvgMinSize
        slDist   = ref_atr14 * i_atrMult

        // bar_index > _fvgFormedBar ensures signal never fires on the same bar the FVG formed
        if _fvgBull and not na(_fvgTop) and not na(_fvgBot) and bar_index > _fvgFormedBar
            fvgSz = _fvgTop - _fvgBot
            if fvgSz >= minFvgSz
                // Price pulls back into FVG zone and closes back above it — bounce entry at close
                if ref_low <= _fvgTop and ref_close > _fvgTop and ref_close > ref_vwap and _entryGateBull
                    sig_m6_bull   := true
                    entryP         = ref_close          // actual fill price, not the stale FVG top
                    slP            = _fvgBot - slDist * 0.5
                    tpP            = entryP + (entryP - slP) * i_m6_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBull, i_colSL, i_colTP)
                    f_drawLabel("M6 FVG", entryP, slP, tpP, true, 1.4, f_modelScore(true,  ref_close, ref_rvol, ref_vwap, ref_rsi14))
                    f_registerTrade(6, entryP, slP, tpP, true)
                    _agreeCountBull += 1
                    if i_showBox
                        array.push(_boxes, box.new(bar_index-3, _fvgTop, bar_index+15, _fvgBot,
                             bgcolor=color.new(#FF9800,80), border_color=color.new(#FF9800,0)))
                    _fvgTriggered := true

        if _fvgBear and not na(_fvgTop) and not na(_fvgBot) and not _fvgTriggered and bar_index > _fvgFormedBar
            fvgSz = _fvgTop - _fvgBot
            if fvgSz >= minFvgSz
                if ref_high >= _fvgBot and ref_close < _fvgBot and ref_close < ref_vwap and _entryGateBear
                    sig_m6_bear   := true
                    entryP         = ref_close          // actual fill price, not the stale FVG bot
                    slP            = _fvgTop + slDist * 0.5
                    tpP            = entryP - (slP - entryP) * i_m6_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBear, i_colSL, i_colTP)
                    f_drawLabel("M6 FVG", entryP, slP, tpP, false, 1.4, f_modelScore(false, ref_close, ref_rvol, ref_vwap, ref_rsi14))
                    f_registerTrade(6, entryP, slP, tpP, false)
                    _agreeCountBear += 1
                    if i_showBox
                        array.push(_boxes, box.new(bar_index-3, _fvgTop, bar_index+15, _fvgBot,
                             bgcolor=color.new(#FF9800,80), border_color=color.new(#FF9800,0)))
                    _fvgTriggered := true

// ============================================================
// SECTION 17 — MODEL 9: Failed ORB Reversal (INLINE — stateful)
// ============================================================

if i_m9_on and _or15Complete and not na(_or15H) and not na(_or15L) and _or15WidthOK
    if _refEdge and inNYSession
        slDist = ref_atr14 * i_atrMult

        // Detect initial breakout attempt
        if not _m9BullBreak and not _m9BearBreak
            if ref_close > _or15H
                _m9BullBreak   := true
                _m9InsideCount := 0
            else if ref_close < _or15L
                _m9BearBreak   := true
                _m9InsideCount := 0

        // Track bars returning inside OR after bull breakout
        if _m9BullBreak and not _m9BearBreak
            if ref_close < _or15L
                // Full reversal through the opposite boundary — re-arm as a bear breakout
                _m9BullBreak   := false
                _m9BearBreak   := true
                _m9InsideCount := 0
            else if ref_close <= _or15H
                _m9InsideCount += 1
            else
                _m9InsideCount := 0  // still outside, reset counter
            // Enough bars back inside → bull failed → short at market (close)
            if _m9InsideCount >= i_m9_failBars and not pastCutoff
                // Always reset state when threshold reached — prevents stuck state on subsequent bars
                _m9BullBreak   := false
                _m9InsideCount := 0
                // Fire on confirmed failure — DXY gate + once-per-day guard
                if _dxyBearGate and _guardOK and not _m9FiredBear
                    sig_m9_bear    := true
                    _m9FiredBear   := true
                    entryP          = ref_close
                    slP             = _or15H + slDist * 0.5
                    tpP             = entryP - (slP - entryP) * i_m9_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBear, i_colSL, i_colTP)
                    f_drawLabel("M9 FailORB", entryP, slP, tpP, false, 4.6, f_modelScore(false, ref_close, ref_rvol, ref_vwap, ref_rsi14))
                    f_registerTrade(9, entryP, slP, tpP, false)

        // Track bars returning inside OR after bear breakout
        if _m9BearBreak and not _m9BullBreak
            if ref_close > _or15H
                // Full reversal through the opposite boundary — re-arm as a bull breakout
                _m9BearBreak   := false
                _m9BullBreak   := true
                _m9InsideCount := 0
            else if ref_close >= _or15L
                _m9InsideCount += 1
            else
                _m9InsideCount := 0
            // Enough bars back inside → bear failed → long at market (close)
            if _m9InsideCount >= i_m9_failBars and not pastCutoff
                // Always reset state — prevents stuck state on subsequent bars
                _m9BearBreak   := false
                _m9InsideCount := 0
                // Fire on confirmed failure — DXY gate + once-per-day guard
                if _dxyBullGate and _guardOK and not _m9FiredBull
                    sig_m9_bull    := true
                    _m9FiredBull   := true
                    entryP          = ref_close
                    slP             = _or15L - slDist * 0.5
                    tpP             = entryP + (entryP - slP) * i_m9_rratio
                    f_drawSLTP(entryP, slP, tpP, i_colBull, i_colSL, i_colTP)
                    f_drawLabel("M9 FailORB", entryP, slP, tpP, true, 4.6, f_modelScore(true,  ref_close, ref_rvol, ref_vwap, ref_rsi14))
                    f_registerTrade(9, entryP, slP, tpP, true)

// ============================================================
// SECTION 17A-M10 — MODEL 10: BDM ORB (inline, global scope)
// Big Daddy Max 3-phase: Phase1=5m breakout, Phase2=1m retest, Phase3=1m bounce
// OR Window: 9:30-9:45 EST (reuses _or15H/_or15L from M4/M7)
// ============================================================

if i_m10_on and _or15Complete and _or15WidthOK
    // ── PHASE 1: 5-min breakout confirmation ───────────────────
    // Gate: _refEdge ensures we only fire on a new 5-min bar close
    if _refEdge and not pastCutoff
        _bdmVolOk = f_volOK(ref_rvol, i_m7_volMult)   // reuse M7 vol threshold (shared param)
        // Bull: 5-min close crosses above OR high — require VWAP + volume
        if ref_close > _or15H and ref_close1 <= _or15H and not _bdmFiredBull and not _bdmBullBreak
             and _bdmVolOk and ref_close > ref_vwap
            _bdmBullBreak      := true
            _bdmBullBreakLevel := _or15H
            _bdmBullWaitBars   := 0
            if i_showSLTP
                if not na(_bdmBullRetestLine)
                    line.delete(_bdmBullRetestLine)
                _bdmBullRetestLine := line.new(bar_index, _or15H, bar_index + 50, _or15H,
                     color=color.new(i_colORLine, 50), style=line.style_dashed, width=1)
                array.push(_lines, _bdmBullRetestLine)

        // Bear: 5-min close crosses below OR low — require VWAP + volume
        if ref_close < _or15L and ref_close1 >= _or15L and not _bdmFiredBear and not _bdmBearBreak
             and _bdmVolOk and ref_close < ref_vwap
            _bdmBearBreak      := true
            _bdmBearBreakLevel := _or15L
            _bdmBearWaitBars   := 0
            if i_showSLTP
                if not na(_bdmBearRetestLine)
                    line.delete(_bdmBearRetestLine)
                _bdmBearRetestLine := line.new(bar_index, _or15L, bar_index + 50, _or15L,
                     color=color.new(i_colORLine, 50), style=line.style_dashed, width=1)
                array.push(_lines, _bdmBearRetestLine)

    // ── PHASE 2 & 3: 1-min retest watch + bounce entry ─────────
    // Gate: _fastEdge ensures we only evaluate on new 1-min bar closes
    if _fastEdge
        // ── Bull path ──────────────────────────────────────────
        if _bdmBullBreak and not _bdmFiredBull
            _bdmBullWaitBars += 1

            // Abort: price fully crosses opposite OR boundary
            if fast_close < _or15L
                _bdmBullBreak      := false
                _bdmBullRetest     := false
                _bdmBullBreakLevel := na
                _bdmBullWaitBars   := 0
                line.delete(_bdmBullRetestLine)
                _bdmBullRetestLine := na

            // Timeout abort
            else if _bdmBullWaitBars > i_bdm_maxWait
                _bdmBullBreak      := false
                _bdmBullRetest     := false
                _bdmBullBreakLevel := na
                _bdmBullWaitBars   := 0
                line.delete(_bdmBullRetestLine)
                _bdmBullRetestLine := na

            // Phase 2: detect a true PULLBACK to the breakout level.
            // One-sided test: close must come back DOWN into the zone (level + tol).
            // An abs-distance test would mark the breakout bar itself as a "retest"
            // since price has only just crossed the level. ≥ 2 wait bars enforces
            // at least one full fast bar between break and retest.
            else if not _bdmBullRetest
                if _bdmBullWaitBars >= 2 and fast_close <= _bdmBullBreakLevel + fast_atr14 * i_bdm_retestTol
                    _bdmBullRetest   := true
                    _bdmBullWaitBars := 0   // reset timeout — Phase 3 gets its own window

            // Phase 3: bounce entry — a BULLISH fast candle closing back above the level.
            // Candle direction is the bounce confirmation; without it, any close a tick
            // above the level (even mid-collapse) would trigger the entry.
            else
                if fast_close > _bdmBullBreakLevel and fast_bullBar and not pastCutoff and _entryGateBull
                    entryP10 = fast_close
                    slP10    = _bdmBullBreakLevel - ref_atr14 * i_bdm_slMult
                    tpP10    = entryP10 + (entryP10 - slP10) * i_bdm_rratio
                    sig_m10_bull   := true
                    _bdmFiredBull  := true
                    f_registerTrade(11, entryP10, slP10, tpP10, true)
                    _agreeCountBull += 1
                    f_drawSLTP(entryP10, slP10, tpP10, i_colBull, i_colSL, i_colTP)
                    f_drawLabel("M10 BDM ▲", entryP10, slP10, tpP10, true, 4.6, f_modelScore(true,  fast_close, fast_rvol, fast_vwap, ref_rsi14))
                    line.delete(_bdmBullRetestLine)
                    _bdmBullRetestLine := na
                    _bdmBullBreak      := false
                    _bdmBullRetest     := false
                    _bdmBullBreakLevel := na
                    _bdmBullWaitBars   := 0

        // ── Bear path ──────────────────────────────────────────
        if _bdmBearBreak and not _bdmFiredBear
            _bdmBearWaitBars += 1

            // Abort: price fully crosses opposite OR boundary
            if fast_close > _or15H
                _bdmBearBreak      := false
                _bdmBearRetest     := false
                _bdmBearBreakLevel := na
                _bdmBearWaitBars   := 0
                line.delete(_bdmBearRetestLine)
                _bdmBearRetestLine := na

            // Timeout abort
            else if _bdmBearWaitBars > i_bdm_maxWait
                _bdmBearBreak      := false
                _bdmBearRetest     := false
                _bdmBearBreakLevel := na
                _bdmBearWaitBars   := 0
                line.delete(_bdmBearRetestLine)
                _bdmBearRetestLine := na

            // Phase 2: true pullback UP into the zone (level − tol) — see bull path notes
            else if not _bdmBearRetest
                if _bdmBearWaitBars >= 2 and fast_close >= _bdmBearBreakLevel - fast_atr14 * i_bdm_retestTol
                    _bdmBearRetest   := true
                    _bdmBearWaitBars := 0

            // Phase 3: bounce entry — a BEARISH fast candle closing back below the level
            else
                if fast_close < _bdmBearBreakLevel and fast_bearBar and not pastCutoff and _entryGateBear
                    entryP10b = fast_close
                    slP10b    = _bdmBearBreakLevel + ref_atr14 * i_bdm_slMult
                    tpP10b    = entryP10b - (slP10b - entryP10b) * i_bdm_rratio   // slP10b > entryP10b for shorts, so this yields a price below entry
                    sig_m10_bear   := true
                    _bdmFiredBear  := true
                    f_registerTrade(11, entryP10b, slP10b, tpP10b, false)
                    _agreeCountBear += 1
                    f_drawSLTP(entryP10b, slP10b, tpP10b, i_colBear, i_colSL, i_colTP)
                    f_drawLabel("M10 BDM ▼", entryP10b, slP10b, tpP10b, false, 4.6, f_modelScore(false, fast_close, fast_rvol, fast_vwap, ref_rsi14))
                    line.delete(_bdmBearRetestLine)
                    _bdmBearRetestLine := na
                    _bdmBearBreak      := false
                    _bdmBearRetest     := false
                    _bdmBearBreakLevel := na
                    _bdmBearWaitBars   := 0

// ============================================================
// SECTION 17A-SCORE — CONFLUENCE SCORE POST-PASS
// Runs after ALL models so _agreeCountBull/Bear are fully accumulated.
// Recomputes score every bar for any model that has fired today (_dashSignal != 0).
// TF routing: M1/Combined → fast TF params; M3/M4/M6/M7/M9 → primary TF params; M10 → mixed.
// ============================================================

// mIdxs: model IDs (1,3,4,6,7,9,11) — must match dashboard mIdxs exactly
var int[] _scoreModelIdxs = array.from(1, 3, 4, 6, 7, 9, 11)

// TF selector per model: true = use fast TF data, false = use primary TF data
// Index maps to mIdxs: M1=fast, M3=primary, M4=primary, M6=primary, M7=primary, M9=primary, M10=fast(price)+primary(rsi)
var bool[] _scoreFast     = array.from(true, false, false, false, false, false, true)

for _si = 0 to 6
    _sModelId = array.get(_scoreModelIdxs, _si)
    _sArrIdx  = _sModelId - 1
    _sDashSig = array.get(_dashSignal, _sArrIdx)
    if _sDashSig != 0
        _sIsBull  = _sDashSig == 1
        _sUseFast = array.get(_scoreFast, _si)
        _sRc   = _sUseFast ? fast_close  : ref_close
        _sRvol = _sUseFast ? fast_rvol   : ref_rvol
        _sVwap = _sUseFast ? fast_vwap   : ref_vwap
        // RSI: M10 uses primary TF RSI even though price is fast TF
        _sRsi  = (_sModelId == 11) ? ref_rsi14 : (_sUseFast ? fast_rsi14 : ref_rsi14)
        _score = f_modelScore(_sIsBull, _sRc, _sRvol, _sVwap, _sRsi)
        array.set(_lastScore, _sArrIdx, _score)

// ============================================================
// SECTION 17B — TRADE STATUS TRACKER (inline, global scope)
// Resolves active trades against bar price action each bar
// ============================================================

// EOD flat time reached (NY) — remaining open trades are booked at market
bool sigEOD = false
_eodNow = i_eodExit and (nyHour > i_eodHour or (nyHour == i_eodHour and nyMin >= i_eodMin))

trSz = array.size(_trStatus)
if trSz > 0
    for _ti = 0 to trSz - 1
        // bar_index > _trBar guard: never resolve a trade on the same bar it was entered.
        // Without this, the signal bar's own low/high (which predate the entry) would
        // immediately trigger SL/TP on the same confirmed bar.
        if array.get(_trStatus, _ti) == 0 and bar_index > array.get(_trBar, _ti)
            _tEntry = array.get(_trEntry, _ti)
            _tSL    = array.get(_trSL,    _ti)
            _tTP    = array.get(_trTP,    _ti)
            _tDir   = array.get(_trDir,   _ti)
            _tpHit  = _tDir == 1 ? high >= _tTP : low  <= _tTP
            _slHit  = _tDir == 1 ? low  <= _tSL : high >= _tSL
            _resolved = false
            // SL checked FIRST: a same-bar TP+SL conflict counts as a LOSS.
            // Intrabar order is unknowable on closed bars — never flatter the stats.
            if _slHit
                array.set(_trStatus, _ti, -1)
                array.set(_trExit,   _ti, _tSL)
                _mI = array.get(_trModel, _ti) - 1
                array.set(_mLosses, _mI, array.get(_mLosses, _mI) + 1)
                _cs = array.get(_mStreak, _mI)
                array.set(_mStreak, _mI, _cs < 0 ? _cs - 1 : -1)
                _lossesToday += 1
                _resolved := true
            else if _tpHit
                array.set(_trStatus, _ti, 1)
                array.set(_trExit,   _ti, _tTP)
                _mI = array.get(_trModel, _ti) - 1
                array.set(_mWins, _mI, array.get(_mWins, _mI) + 1)
                _cs = array.get(_mStreak, _mI)
                array.set(_mStreak, _mI, _cs > 0 ? _cs + 1 : 1)
                _resolved := true
            else if _eodNow
                // EOD flat at market — win/loss booked by the sign of the result
                array.set(_trStatus, _ti, 2)
                array.set(_trExit,   _ti, close)
                _mI = array.get(_trModel, _ti) - 1
                _eodGain = (close - _tEntry) * _tDir
                if _eodGain >= 0
                    array.set(_mWins, _mI, array.get(_mWins, _mI) + 1)
                    _cs = array.get(_mStreak, _mI)
                    array.set(_mStreak, _mI, _cs > 0 ? _cs + 1 : 1)
                else
                    array.set(_mLosses, _mI, array.get(_mLosses, _mI) + 1)
                    _cs = array.get(_mStreak, _mI)
                    array.set(_mStreak, _mI, _cs < 0 ? _cs - 1 : -1)
                    _lossesToday += 1
                sigEOD := true
                _resolved := true
            if _resolved
                _bTP = array.get(_trBoxTP, _ti)
                _bSL = array.get(_trBoxSL, _ti)
                if not na(_bTP)
                    box.set_right(_bTP, bar_index)
                if not na(_bSL)
                    box.set_right(_bSL, bar_index)

// Trim old trades when array exceeds i_maxTrades
while array.size(_trEntry) > i_maxTrades
    array.shift(_trEntry)
    array.shift(_trSL)
    array.shift(_trTP)
    array.shift(_trModel)
    array.shift(_trDir)
    array.shift(_trStatus)
    array.shift(_trBar)
    array.shift(_trDay)
    array.shift(_trExit)
    array.shift(_trBoxTP)
    array.shift(_trBoxSL)

// ============================================================
// SECTION 17C — DAY BIAS CALCULATION
// 4-method weighted aggregation (computed once per bar)
// ============================================================

// HTF Trend (35%): EMA20/50 alignment
_bHTF = htfClose > htfEma20 and htfEma20 > htfEma50 ? 35.0 :
         htfClose > htfEma50 ? 17.5 :
         htfClose < htfEma20 and htfEma20 < htfEma50 ? -35.0 :
         htfClose < htfEma50 ? -17.5 : 0.0

// VWAP Position (30%)
_bVWAP = not na(ref_vwap) ? (ref_close > ref_vwap ? 30.0 : -30.0) : 0.0

// Gap Direction (17.5%): today's open vs prior close
_bGap = na(_pdClose) or _pdClose == 0 ? 0.0 :
         dOpen > _pdClose ? 17.5 : dOpen < _pdClose ? -17.5 : 0.0

// Prev Close in Prev Range (17.5%)
_pdRange = _pdHigh - _pdLow
_bPrev = _pdRange > 0 ?
         (_pdClose >= _pdHigh - _pdRange * 0.33 ? 17.5 :
          _pdClose <= _pdLow  + _pdRange * 0.33 ? -17.5 : 0.0) : 0.0

_biasScore := _bHTF + _bVWAP + _bGap + _bPrev
_dayBias   := _biasScore >= 35 ? "BULLISH" : _biasScore <= -35 ? "BEARISH" : "NEUTRAL"

// ============================================================
// SECTION 18 — CONFIDENCE SCORE ENGINE (Combined mode)
// ============================================================

// All scoring functions are pure (read-only global access)

f_scoreVolume(_rvol) =>
    na(_rvol) ? 50.0 : _rvol >= 2.0 ? 100.0 : _rvol >= 1.5 ? 80.0 : _rvol >= 1.2 ? 60.0 : 20.0

f_scoreHTF(isBull) =>
    if isBull
        (htfClose > htfEma20 and htfEma20 > htfEma50) ? 100.0 :
         htfClose > htfEma20 ? 60.0 : 0.0
    else
        (htfClose < htfEma20 and htfEma20 < htfEma50) ? 100.0 :
         htfClose < htfEma20 ? 60.0 : 0.0

f_scoreDayType() =>
    gapPct = na(_pdClose) or _pdClose == 0 ? 0.0 :
              math.abs(dOpen - _pdClose) / _pdClose * 100.0
    gapPct >= 0.5 ? 100.0 : gapPct >= 0.3 ? 70.0 : 30.0

f_scoreNR() =>
    isNR7 ? 100.0 : isNR4 ? 70.0 : 20.0

f_scoreATR() =>
    if na(_or15H) or na(_or15L) or na(ref_atr14) or ref_atr14 == 0
        0.0
    else
        ratio = (_or15H - _or15L) / ref_atr14
        (ratio >= 0.5 and ratio <= 1.5) ? 100.0 :
         (ratio >= 0.3 and ratio <= 2.0) ? 60.0 : 20.0

f_scoreCloseQuality(isBull, _rc, _ratr) =>
    if na(_or15H) or na(_or15L) or na(_ratr) or _ratr == 0
        0.0
    else if isBull
        pen = _rc - _or15H
        pen >= _ratr * 0.5 ? 100.0 : pen >= _ratr * 0.25 ? 70.0 : pen > 0 ? 40.0 : 0.0
    else
        pen = _or15L - _rc
        pen >= _ratr * 0.5 ? 100.0 : pen >= _ratr * 0.25 ? 70.0 : pen > 0 ? 40.0 : 0.0

f_scoreVWAP(isBull, _rc, _rvwap) =>
    na(_rvwap) ? 0.0 : isBull ? (_rc > _rvwap ? 100.0 : 0.0) : (_rc < _rvwap ? 100.0 : 0.0)

f_scoreOrderFlow(isBull, _rh, _rl, _rc, _bullBar, _bearBar) =>
    cRange = _rh - _rl
    if cRange == 0
        0.0
    else
        // Use close vs midpoint as a TF-consistent body-strength proxy
        midP  = (_rh + _rl) / 2.0
        ratio = math.abs(_rc - midP) / (cRange / 2.0)
        if isBull
            _bullBar ? (ratio >= 0.6 ? 100.0 : ratio >= 0.4 ? 70.0 : 40.0) : 0.0
        else
            _bearBar ? (ratio >= 0.6 ? 100.0 : ratio >= 0.4 ? 70.0 : 40.0) : 0.0

// ── DXY Inverse Correlation Score ────────────────────────────
// Bull Gold → DXY should be bearish; Bear Gold → DXY should be bullish.
// Returns 0.0 when disabled or na (neutral, no penalty).
f_scoreDXY(isBull, _dClose, _dEma20, _dEma50) =>
    if not _dxyActive
        0.0
    else if na(_dClose) or na(_dEma20) or na(_dEma50)
        0.0
    else if isBull
        (_dClose < _dEma20 and _dEma20 < _dEma50) ? 100.0 :
         _dClose < _dEma20                          ?  60.0 : 20.0
    else
        (_dClose > _dEma20 and _dEma20 > _dEma50) ? 100.0 :
         _dClose > _dEma20                          ?  60.0 : 20.0

// _rc/_rc1/_ratr/_rvol/_rvwap/_rh/_rl/_bullBar/_bearBar: TF data to use for scoring
f_confidence(isBull, _rc, _ratr, _rvol, _rvwap, _rh, _rl, _bullBar, _bearBar, _dClose, _dEma20, _dEma50) =>
    _dxyW  = _dxyActive ? i_wDXY : 0
    totalW = i_wVol + i_wHTF + i_wDay + i_wNR + i_wATR + i_wClose + i_wVWAP + i_wFlow + _dxyW
    if totalW == 0
        0.0
    else
        wSum = f_scoreVolume(_rvol)                              * i_wVol  +
               f_scoreHTF(isBull)                               * i_wHTF  +
               f_scoreDayType()                                 * i_wDay  +
               f_scoreNR()                                      * i_wNR   +
               f_scoreATR()                                     * i_wATR  +
               f_scoreCloseQuality(isBull, _rc, _ratr)          * i_wClose +
               f_scoreVWAP(isBull, _rc, _rvwap)                 * i_wVWAP +
               f_scoreOrderFlow(isBull, _rh, _rl, _rc, _bullBar, _bearBar) * i_wFlow +
               f_scoreDXY(isBull, _dClose, _dEma20, _dEma50)   * _dxyW
        wSum / totalW

f_grade(score) =>
    score >= 80 ? "A" : score >= 60 ? "B" : score >= 40 ? "C" : "F"

// Formats raw pip value → "+123.4p" / "-45.0p" for display
f_formatPips(pips) =>
    rounded = math.round(pips * 10) / 10.0
    (rounded >= 0 ? "+" : "") + str.tostring(rounded, "#.#") + "p"

// ── Combined Mode Signal (INLINE) ─────────────────────────────
// Uses fast TF (default 1m) for signal trigger and scoring — best per CSV (50–90% WR)
if i_comb_on and _or15Complete and not na(_or15H) and not na(_or15L) and _or15WidthOK
    if _fastEdge and not pastCutoff and inNYSession
        // DXY hard gate (inverse: DXY bear confirms Gold bull, DXY bull confirms Gold bear)
        _dxyBullish = (not _dxyActive or not i_dxy_hard_gate) ? true :
             (na(dxy_close) or na(dxy_ema20)) ? true : dxy_close < dxy_ema20
        _dxyBearish = (not _dxyActive or not i_dxy_hard_gate) ? true :
             (na(dxy_close) or na(dxy_ema20)) ? true : dxy_close > dxy_ema20
        slDist = fast_atr14 * i_atrMult

        if fast_close > _or15H and fast_close1 <= _or15H and not _combLongFired and _dxyBullish and _guardOK and (not i_dirFilter or _or15Dir == 1)
            score = f_confidence(true, fast_close, fast_atr14, fast_rvol, fast_vwap, fast_high, fast_low, fast_bullBar, fast_bearBar, dxy_close, dxy_ema20, dxy_ema50)
            if score >= float(i_minScore)
                sig_comb_bull   := true
                _combLongFired  := true
                _confScore      := score
                _confBull       := true
                _confGrade      := f_grade(score)
                entryP         = _or15H
                slP            = entryP - slDist
                tpP            = entryP + slDist * 2.0
                f_drawSLTP(entryP, slP, tpP, i_colBull, i_colSL, i_colTP)
                f_registerTrade(10, entryP, slP, tpP, true)
                if i_showLabels
                    array.push(_labels, label.new(bar_index, low - atr14 * 0.5,
                         text      = "COMBINED LONG\nEntry: " + str.tostring(entryP, format.mintick) +
                                     "\nSL: "    + str.tostring(slP, format.mintick) +
                                     "\nTP: "    + str.tostring(tpP, format.mintick) +
                                     "\nScore: " + str.tostring(math.round(score)) + "% [" + f_grade(score) + "]",
                         color     = i_colBull,
                         style     = label.style_label_up,
                         textcolor = color.white,
                         size      = size.normal))

        if fast_close < _or15L and fast_close1 >= _or15L and not _combShortFired and _dxyBearish and _guardOK and (not i_dirFilter or _or15Dir == -1)
            score = f_confidence(false, fast_close, fast_atr14, fast_rvol, fast_vwap, fast_high, fast_low, fast_bullBar, fast_bearBar, dxy_close, dxy_ema20, dxy_ema50)
            if score >= float(i_minScore)
                sig_comb_bear   := true
                _combShortFired := true
                _confScore      := score
                _confBull       := false
                _confGrade      := f_grade(score)
                entryP         = _or15L
                slP            = entryP + slDist
                tpP            = entryP - slDist * 2.0
                f_drawSLTP(entryP, slP, tpP, i_colBear, i_colSL, i_colTP)
                f_registerTrade(10, entryP, slP, tpP, false)
                if i_showLabels
                    array.push(_labels, label.new(bar_index, high + atr14 * 0.5,
                         text      = "COMBINED SHORT\nEntry: " + str.tostring(entryP, format.mintick) +
                                     "\nSL: "    + str.tostring(slP, format.mintick) +
                                     "\nTP: "    + str.tostring(tpP, format.mintick) +
                                     "\nScore: " + str.tostring(math.round(score)) + "% [" + f_grade(score) + "]",
                         color     = i_colBear,
                         style     = label.style_label_down,
                         textcolor = color.white,
                         size      = size.normal))

// ============================================================
// SECTION 18B — DAY BIAS CHART LABEL (always visible, both modes)
// Floats at the right edge of the chart, updates every bar
// ============================================================

_biasArrow  = _dayBias == "BULLISH" ? " ▲" : _dayBias == "BEARISH" ? " ▼" : " —"
_biasHTFStr = htfClose > htfEma20 and htfEma20 > htfEma50 ? "Bull" : htfClose < htfEma20 and htfEma20 < htfEma50 ? "Bear" : "Neutral"
_biasVWAPStr = not na(ref_vwap) ? (ref_close > ref_vwap ? "Above" : "Below") : "NA"
_biasScoreStr = str.tostring(math.round(math.abs(_biasScore))) + "%"
// DXY label line with actionable recommendation
// Recommendation logic: DXY + Day Bias must AGREE for a clear trade call
_dxyIsBear  = _dxyActive and not na(dxy_close) and not na(dxy_ema20) and dxy_close < dxy_ema20
_dxyIsBull  = _dxyActive and not na(dxy_close) and not na(dxy_ema20) and dxy_close > dxy_ema20
_dxyRec     = not _dxyActive or (na(dxy_close) or na(dxy_ema20))        ? "" :
     _dxyIsBear and _dayBias == "BULLISH"                               ? " → GO LONG" :
     _dxyIsBull and _dayBias == "BEARISH"                               ? " → GO SHORT" :
     _dayBias == "NEUTRAL"                                               ? " → WAIT" :
                                                                           " → AVOID"
_dxyLabelLine = not _dxyActive                                          ? "" :
     na(dxy_close) or na(dxy_ema20)                                     ? "\nDXY: N/A" :
     dxy_close < dxy_ema20 and dxy_ema20 < dxy_ema50                   ? "\nDXY: ▼▼ Bear (Gold+)" + _dxyRec :
     dxy_close < dxy_ema20                                               ? "\nDXY: ▼ Soft Bear (Gold+)" + _dxyRec :
     dxy_close > dxy_ema20 and dxy_ema20 > dxy_ema50                   ? "\nDXY: ▲▲ Bull (Gold-)" + _dxyRec :
     dxy_close > dxy_ema20                                               ? "\nDXY: ▲ Soft Bull (Gold-)" + _dxyRec : ""
_newsActive    = i_news_on and _isGoldChart
_cpiDirStr     = _lastCpiMoM > 0 ? "▲ HOT → Gold-"    : _lastCpiMoM < 0 ? "▼ COOL → Gold+" : "—"
_nfpDirStr     = _lastNfpMoM > 0 ? "▲ STRONG → Gold-" : _lastNfpMoM < 0 ? "▼ WEAK → Gold+" : "—"
_cpiLabelLine  = not _newsActive or na(econ_cpi) ? "" :
     "\n" + (_cpiToday ? "! " : "") + "CPI " + str.tostring(econ_cpi, "#.##") + " " + _cpiDirStr
_nfpLabelLine  = not _newsActive or na(econ_nfp) ? "" :
     "\n" + (_nfpToday ? "! " : "") + "NFP " + str.tostring(math.round(econ_nfp / 1000)) + "K " + _nfpDirStr
_biasLabelTxt = "DAY BIAS: " + _dayBias + _biasArrow + "\nScore: " + _biasScoreStr + "\nHTF: " + _biasHTFStr + "  VWAP: " + _biasVWAPStr + _dxyLabelLine + _cpiLabelLine + _nfpLabelLine
_biasLabelClr = _dayBias == "BULLISH" ? color.new(#00E676, 15) : _dayBias == "BEARISH" ? color.new(#FF1744, 15) : color.new(#607D8B, 15)
_biasLabelY   = ref_close + ref_atr14 * 2.0

if na(_biasChartLabel)
    _biasChartLabel := label.new(bar_index, _biasLabelY, _biasLabelTxt,
         color=_biasLabelClr, style=label.style_label_left,
         textcolor=color.white, size=size.normal)
else
    label.set_x(_biasChartLabel, bar_index)
    label.set_y(_biasChartLabel, _biasLabelY)
    label.set_text(_biasChartLabel, _biasLabelTxt)
    label.set_color(_biasChartLabel, _biasLabelClr)

// ============================================================
// SECTION 18C — COMBINED PENDING SETUP (limit-order preview)
// Shows potential long/short at OR levels BEFORE breakout fires
// Gives user time to place limit orders at OR H/L in advance
// ============================================================

// Combined pending limit-order labels removed

// ============================================================
// SECTION 19 — DASHBOARD TABLES
// ============================================================

f_tablePos(p) =>
    p == "Top Right"    ? position.top_right    :
     p == "Top Left"    ? position.top_left     :
     p == "Bottom Right"? position.bottom_right :
                          position.bottom_left

C_HEAD     = color.new(#1565C0, 0)
C_NONE     = color.new(#1A1D26, 0)
C_BULL_DIM = color.new(#00E676, 50)
C_BEAR_DIM = color.new(#FF1744, 50)
C_TXT      = i_colTxtMain
C_TXT_DIM  = i_colTxtDim

// Text size helpers — used for every table.cell() call
_dashSz = i_dashTextSize == "Normal" ? size.normal : i_dashTextSize == "Small" ? size.small : size.tiny
_headSz = i_dashTextSize == "Normal" ? size.large  : i_dashTextSize == "Small" ? size.normal : size.small

// ── Win-rate helper: reads per-model counters (unaffected by array trim or other models) ─
f_winRate(modelIdx) =>
    _wi = modelIdx - 1
    w   = array.get(_mWins,   _wi)
    l   = array.get(_mLosses, _wi)
    [w, l, w + l]

// ── Multi-Model Dashboard ─────────────────────────────────────
if i_showDashboard
    if na(_dashTable)
        _dashTable := table.new(f_tablePos(i_dashPos), 10, 10,
             bgcolor       = color.new(#1A1D26, 10),
             border_color  = color.new(color.gray, 50),
             border_width  = 1,
             frame_color   = color.new(color.gray, 30),
             frame_width   = 1)

    // Header row
    table.cell(_dashTable, 0, 0, "MODEL",   text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 1, 0, "SIGNAL",  text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 2, 0, "DIR",     text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 3, 0, "ENTRY",   text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 4, 0, "SL",      text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 5, 0, "TP",      text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 6, 0, "WIN%",    text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 7, 0, "OR HIGH", text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 8, 0, "OR LOW",  text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_dashTable, 9, 0, "SCORE",   text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)

    // Data rows — read from persistent _dashSignal and _lastEntry/SL/TP arrays
    orHStr = na(_or15H) ? "-" : str.tostring(_or15H, format.mintick)
    orLStr = na(_or15L) ? "-" : str.tostring(_or15L, format.mintick)

    mNames = array.from("★★ 1.Crabel","★★★ 3.5min","★★★ 4.15min","★ 6.FVG","★ 7.Gold","★ 9.FailORB","★★ 10.BDM")
    mIdxs  = array.from(1, 3, 4, 6, 7, 9, 11)

    // Temp storage for BEST badge deferred re-render
    var string[] _rowName   = array.new<string>(7, "")
    var string[] _rowSig    = array.new<string>(7, "")
    var string[] _rowDir    = array.new<string>(7, "")
    var string[] _rowEnt    = array.new<string>(7, "")
    var string[] _rowSl     = array.new<string>(7, "")
    var string[] _rowTp     = array.new<string>(7, "")
    var string[] _rowWr     = array.new<string>(7, "")
    var color[]  _rowSigClr = array.new<color>(7, color.gray)
    var color[]  _rowWrClr  = array.new<color>(7, color.gray)
    var color[]  _rowBG     = array.new<color>(7, color.new(#1A1D26, 10))

    for i = 0 to 6
        _arrIdx = array.get(mIdxs, i) - 1  // model ID → backing array slot (M1→0, M3→2, ..., M10→10)
        dSig    = array.get(_dashSignal, _arrIdx)
        isBull  = dSig == 1
        isBear  = dSig == -1
        rowBG   = isBull ? C_BULL_DIM : isBear ? C_BEAR_DIM : C_NONE
        sigStr  = isBull ? "LONG"   : isBear ? "SHORT"  : "-"
        dirStr  = isBull ? "▲ BULL" : isBear ? "▼ BEAR" : "-"
        sigClr  = isBull ? i_colBull : isBear ? i_colBear : C_TXT_DIM
        lEntry  = array.get(_lastEntry, _arrIdx)
        lSL     = array.get(_lastSL,    _arrIdx)
        lTP     = array.get(_lastTP,    _arrIdx)
        entStr  = na(lEntry) ? "-" : str.tostring(lEntry, format.mintick)
        slStr   = na(lSL)    ? "-" : str.tostring(lSL,    format.mintick)
        tpStr   = na(lTP)    ? "-" : str.tostring(lTP,    format.mintick)
        [mW, mL, mT] = f_winRate(array.get(mIdxs, i))
        wrStr   = mT >= 1 ? str.tostring(math.round(float(mW) / float(mT) * 100)) + "%" : "-"
        wrClr   = mT < 1 ? C_TXT_DIM : float(mW) / float(mT) >= 0.6 ? i_colWinHigh :
                   float(mW) / float(mT) >= 0.5 ? i_colWinMid : i_colWinLow
        row     = i + 1
        table.cell(_dashTable, 0, row, array.get(mNames,i),  text_color=C_TXT,    bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 1, row, sigStr,                text_color=sigClr,   bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 2, row, dirStr,                text_color=sigClr,   bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 3, row, entStr,                text_color=sigClr,   bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 4, row, slStr,                 text_color=i_colSL, bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 5, row, tpStr,                 text_color=i_colTP, bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 6, row, wrStr,                 text_color=wrClr,    bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 7, row, orHStr,                text_color=C_TXT_DIM,bgcolor=rowBG, text_size=_dashSz)
        table.cell(_dashTable, 8, row, orLStr,                text_color=C_TXT_DIM,bgcolor=rowBG, text_size=_dashSz)
        scoreVal = array.get(_lastScore, _arrIdx)
        scoreClr = scoreVal >= 70 ? i_colWinHigh :
                   scoreVal >= 50 ? i_colWinMid :
                   scoreVal >  0  ? i_colWinLow : C_TXT_DIM
        scoreStr = scoreVal > 0 ? str.tostring(scoreVal) : "-"
        table.cell(_dashTable, 9, row, scoreStr, text_color=scoreClr, bgcolor=rowBG, text_size=_dashSz)
        // Store for BEST badge deferred render
        array.set(_rowName,   i, array.get(mNames, i))
        array.set(_rowSig,    i, sigStr)
        array.set(_rowDir,    i, dirStr)
        array.set(_rowEnt,    i, entStr)
        array.set(_rowSl,     i, slStr)
        array.set(_rowTp,     i, tpStr)
        array.set(_rowWr,     i, wrStr)
        array.set(_rowSigClr, i, sigClr)
        array.set(_rowWrClr,  i, wrClr)
        array.set(_rowBG,     i, rowBG)

    // ── BEST badge: highlight highest-scoring row in gold ─────────
    _bestScore2 = 0
    _bestRow2   = -1
    for _bi2 = 0 to 6
        _bs2 = array.get(_lastScore, array.get(mIdxs, _bi2) - 1)
        if _bs2 > _bestScore2
            _bestScore2 := _bs2
            _bestRow2   := _bi2

    if _bestRow2 >= 0 and not na(_dashTable)
        GOLD_BG  = color.new(#FFD600, 70)
        GOLD_TXT = color.new(#FFD600, 0)
        _br      = _bestRow2 + 1  // table row (0 = header, 1–7 = models)
        _bSigClr = array.get(_rowSigClr, _bestRow2)
        _bWrClr  = array.get(_rowWrClr,  _bestRow2)
        _bScoreVal = array.get(_lastScore, array.get(mIdxs, _bestRow2) - 1)
        _bScoreStr = _bScoreVal > 0 ? str.tostring(_bScoreVal) : "-"
        _bScoreClr = _bScoreVal >= 70 ? i_colWinHigh : _bScoreVal >= 50 ? i_colWinMid : i_colWinLow
        table.cell(_dashTable, 0, _br, array.get(_rowName, _bestRow2) + " ◀", text_color=GOLD_TXT, bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 1, _br, array.get(_rowSig,  _bestRow2),         text_color=_bSigClr,  bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 2, _br, array.get(_rowDir,  _bestRow2),         text_color=_bSigClr,  bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 3, _br, array.get(_rowEnt,  _bestRow2),         text_color=_bSigClr,  bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 4, _br, array.get(_rowSl,   _bestRow2),         text_color=i_colSL, bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 5, _br, array.get(_rowTp,   _bestRow2),         text_color=i_colTP, bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 6, _br, array.get(_rowWr,   _bestRow2),         text_color=_bWrClr,   bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 7, _br, orHStr,                                  text_color=C_TXT_DIM,  bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 8, _br, orLStr,                                  text_color=C_TXT_DIM,  bgcolor=GOLD_BG, text_size=_dashSz)
        table.cell(_dashTable, 9, _br, _bScoreStr,                              text_color=_bScoreClr, bgcolor=GOLD_BG, text_size=_dashSz)

// ── RVOL display row (row 8) ─────────────────────────────────
if i_showDashboard and not na(_dashTable)
    rvolStr = str.tostring(math.round(ref_rvol * 100) / 100.0)
    rvolClr = ref_rvol >= 2.0 ? color.new(#FF6F00,0) : ref_rvol >= 1.5 ? color.new(#FF9800,0) : C_TXT_DIM
    table.cell(_dashTable, 0, 8, "RVOL: " + rvolStr, text_color=rvolClr,   bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 1, 8, "ATR: "  + str.tostring(math.round(ref_atr14 * 100) / 100.0),
         text_color=C_TXT_DIM, bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 2, 8, "VWAP: " + str.tostring(ref_vwap, format.mintick),
         text_color=C_TXT_DIM, bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 3, 8, isNR7 ? "NR7" : isNR4 ? "NR4" : "-",
         text_color=isNR7 or isNR4 ? color.new(#FF9800,0) : C_TXT_DIM, bgcolor=C_NONE, text_size=_dashSz)
    _bullAgStr = _agreeCountBull > 0 ? str.tostring(_agreeCountBull) + " BULL ↑" : "-"
    _bearAgStr = _agreeCountBear > 0 ? str.tostring(_agreeCountBear) + " BEAR ↓" : "-"
    table.cell(_dashTable, 4, 8, _bullAgStr, text_color=_agreeCountBull > 0 ? color.new(#00E676,0) : C_TXT_DIM, bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 5, 8, _bearAgStr, text_color=_agreeCountBear > 0 ? color.new(#FF5252,0) : C_TXT_DIM, bgcolor=C_NONE, text_size=_dashSz)
    _dxyStatusStr = not _dxyActive                          ? "DXY: OFF" :
         na(dxy_close) or na(dxy_ema20)                     ? "DXY: N/A" :
         dxy_close < dxy_ema20 and dxy_ema20 < dxy_ema50   ? "DXY ▼▼" :
         dxy_close < dxy_ema20                               ? "DXY ▼"   :
         dxy_close > dxy_ema20 and dxy_ema20 > dxy_ema50   ? "DXY ▲▲" :
         dxy_close > dxy_ema20                               ? "DXY ▲"   : "DXY —"
    _dxyStatusClr = not _dxyActive or na(dxy_close) ? C_TXT_DIM :
         dxy_close < dxy_ema20 ? color.new(#00E676, 0) :
         dxy_close > dxy_ema20 ? color.new(#FF5252, 0) : C_TXT_DIM
    table.cell(_dashTable, 6, 8, _dxyStatusStr, text_color=_dxyStatusClr, bgcolor=C_NONE, text_size=_dashSz)
    // OR-window RVOL (the studies' filter) — shown even when the gate is off
    _orRvolStr = na(_or15RVOL) ? "OR-RVOL: -" : "OR-RVOL: " + str.tostring(_or15RVOL, "#.##") + "×"
    _orRvolClr = na(_or15RVOL) ? C_TXT_DIM : _or15RVOL >= 2.0 ? color.new(#FF6F00,0) : _or15RVOL >= 1.5 ? color.new(#FF9800,0) : C_TXT_DIM
    table.cell(_dashTable, 7, 8, _orRvolStr, text_color=_orRvolClr, bgcolor=C_NONE, text_size=_dashSz)
    _guardStr = not i_newsGuard ? "" : _newsOK ? "GUARD ✓" : "⛔ NEWS (" + str.tostring(_blockUntilBar - bar_index) + ")"
    table.cell(_dashTable, 8, 8, _guardStr, text_color=_newsOK ? C_TXT_DIM : color.new(#FF6E6E,0), bgcolor=C_NONE, text_size=_dashSz)
    _dayLossStr = i_maxLossDay > 0 ? "DayLoss " + str.tostring(_lossesToday) + "/" + str.tostring(i_maxLossDay) :
         _lossesToday > 0 ? "DayLoss " + str.tostring(_lossesToday) : ""
    table.cell(_dashTable, 9, 8, _dayLossStr, text_color=not _lossOK ? color.new(#FF6E6E,0) : C_TXT_DIM, bgcolor=C_NONE, text_size=_dashSz)

    // Day Bias row (row 9)
    biasClr = _dayBias == "BULLISH" ? color.new(#00E676,0) :
               _dayBias == "BEARISH" ? color.new(#FF1744,0) : C_TXT_DIM
    biasBG  = _dayBias == "BULLISH" ? color.new(#00E676,85) :
               _dayBias == "BEARISH" ? color.new(#FF1744,85) : C_NONE
    biasScoreStr = str.tostring(math.round(math.abs(_biasScore))) + "%"
    table.cell(_dashTable, 0, 9, "DAY BIAS",        text_color=C_TXT,    bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_dashTable, 1, 9, _dayBias,           text_color=biasClr,  bgcolor=biasBG, text_size=_dashSz)
    table.cell(_dashTable, 2, 9, biasScoreStr,        text_color=biasClr,  bgcolor=biasBG, text_size=_dashSz)
    _orDirStr = not _or15Complete ? "" : _or15Dir == 1 ? "OR ▲" : _or15Dir == -1 ? "OR ▼" : "OR —"
    _orDirClr = _or15Dir == 1 ? i_colBull : _or15Dir == -1 ? i_colBear : C_TXT_DIM
    table.cell(_dashTable, 3, 9, _orDirStr,           text_color=_orDirClr,bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 4, 9, "",                  text_color=C_TXT_DIM,bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 5, 9, "",                  text_color=C_TXT_DIM,bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 6, 9, "",                  text_color=C_TXT_DIM,bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 7, 9, "",                  text_color=C_TXT_DIM,bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 8, 9, "",                  text_color=C_TXT_DIM,bgcolor=C_NONE, text_size=_dashSz)
    table.cell(_dashTable, 9, 9, "",                  text_color=C_TXT_DIM,bgcolor=C_NONE, text_size=_dashSz)

// ============================================================
// SECTION 19B — ENTRIES / TRADES TABLE (today's trades)
// ============================================================

if i_showTradeTable
    if na(_tradeTable)
        _tradeTable := table.new(f_tablePos(i_tradeTablePos), 7, 13,
             bgcolor       = color.new(#1A1D26, 10),
             border_color  = color.new(color.gray, 50),
             border_width  = 1,
             frame_color   = color.new(color.gray, 30),
             frame_width   = 1)

    // Header — col 0=MODEL, 1=DIR, 2=ENTRY, 3=SL, 4=TP, 5=PIPS, 6=STATUS
    table.cell(_tradeTable, 0, 0, "MODEL",  text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_tradeTable, 1, 0, "DIR",    text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_tradeTable, 2, 0, "ENTRY",  text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_tradeTable, 3, 0, "SL",     text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_tradeTable, 4, 0, "TP",     text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_tradeTable, 5, 0, "PIPS",   text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_tradeTable, 6, 0, "STATUS", text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)

    // Today's trades only (most recent first), up to 10 rows
    _todayWins     = 0
    _todayTotal    = 0
    _todayPips     = 0.0
    _displayRow    = 1
    trSz2 = array.size(_trStatus)
    if trSz2 > 0
        for _ti2 = trSz2 - 1 to 0
            if _displayRow > 10
                break
            if array.get(_trDay, _ti2) == currentDay
                _tMdl  = array.get(_trModel,  _ti2)
                _tDir2 = array.get(_trDir,    _ti2)
                _tSt   = array.get(_trStatus, _ti2)
                _tEnt  = array.get(_trEntry,  _ti2)
                _tSl2  = array.get(_trSL,     _ti2)
                _tTp2  = array.get(_trTP,     _ti2)

                // Pip P&L: closed = stored exit price (TP/SL/EOD); active = current ref_close
                _exitStored = array.get(_trExit, _ti2)
                _exitP   = _tSt == 0 or na(_exitStored) ? ref_close : _exitStored
                _pipsRaw = (_exitP - _tEnt) * float(_tDir2) / _pipSize
                _pipsStr = f_formatPips(_pipsRaw)
                _pipsClr = _tSt == 0 ? color.new(#FF9800, 0) :
                           _pipsRaw >= 0 ? color.new(#00E676, 0) : color.new(#FF1744, 0)

                _mNameStr = _tMdl == 1  ? "M1 Crabel" :
                             _tMdl == 3  ? "M3 5min"   :
                             _tMdl == 4  ? "M4 15min"  :
                             _tMdl == 6  ? "M6 FVG"    :
                             _tMdl == 7  ? "M7 Gold"   :
                             _tMdl == 9  ? "M9 FailORB":
                             _tMdl == 11 ? "M10 BDM"   : "Combined"
                _dirStr2 = _tDir2 == 1 ? "▲ LONG" : "▼ SHORT"
                _dirClr  = _tDir2 == 1 ? i_colBull : i_colBear
                _stStr   = _tSt == 0 ? "IN PROG" : _tSt == 1 ? "TP HIT" : _tSt == 2 ? "EOD" : "SL HIT"
                _stClr   = _tSt == 0 ? color.new(#FF9800,0) : _tSt == 1 ? color.new(#00E676,0) :
                           _tSt == 2 ? color.new(#90A4AE,0) : color.new(#FF1744,0)
                _rowBG2  = _tSt == 0 ? color.new(#FF9800,85) : _tSt == 1 ? color.new(#00E676,85) :
                           _tSt == 2 ? color.new(#90A4AE,85) : color.new(#FF1744,85)
                table.cell(_tradeTable, 0, _displayRow, _mNameStr,                           text_color=C_TXT,   bgcolor=_rowBG2, text_size=_dashSz)
                table.cell(_tradeTable, 1, _displayRow, _dirStr2,                            text_color=_dirClr, bgcolor=_rowBG2, text_size=_dashSz)
                table.cell(_tradeTable, 2, _displayRow, str.tostring(_tEnt, format.mintick), text_color=C_TXT,   bgcolor=_rowBG2, text_size=_dashSz)
                table.cell(_tradeTable, 3, _displayRow, str.tostring(_tSl2, format.mintick), text_color=i_colSL, bgcolor=_rowBG2, text_size=_dashSz)
                table.cell(_tradeTable, 4, _displayRow, str.tostring(_tTp2, format.mintick), text_color=i_colTP, bgcolor=_rowBG2, text_size=_dashSz)
                table.cell(_tradeTable, 5, _displayRow, _pipsStr,                            text_color=_pipsClr,bgcolor=_rowBG2, text_size=_dashSz)
                table.cell(_tradeTable, 6, _displayRow, _stStr,                              text_color=_stClr,  bgcolor=_rowBG2, text_size=_dashSz)
                if _tSt != 0
                    _todayTotal  += 1
                    _todayPips   += _pipsRaw
                    if _tSt == 1
                        _todayWins += 1
                _displayRow += 1

    // Fill empty rows up to row 11
    if _displayRow <= 11
        for _er = _displayRow to 11
            for _ec = 0 to 6
                table.cell(_tradeTable, _ec, _er, "", text_color=C_TXT_DIM, bgcolor=C_NONE, text_size=_dashSz)

    // Summary row — win rate + total pip P&L for the day
    _wrStr   = _todayTotal > 0 ?
         "Today: " + str.tostring(_todayWins) + "/" + str.tostring(_todayTotal) +
         " (" + str.tostring(math.round(float(_todayWins) / float(_todayTotal) * 100)) + "%)" :
         "Today: No completed trades"
    _wrClr   = _todayTotal == 0 ? C_TXT_DIM :
               float(_todayWins) / float(_todayTotal) >= 0.5 ? color.new(#00E676,0) : color.new(#FF1744,0)
    _dayPipsStr = _todayTotal > 0 ? "P&L: " + f_formatPips(_todayPips) : ""
    _dayPipsClr = _todayPips >= 0 ? color.new(#00E676,0) : color.new(#FF1744,0)
    table.cell(_tradeTable, 0, 12, _wrStr,      text_color=_wrClr,     bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_tradeTable, 1, 12, "",           text_color=C_TXT_DIM,  bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_tradeTable, 2, 12, "",           text_color=C_TXT_DIM,  bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_tradeTable, 3, 12, "",           text_color=C_TXT_DIM,  bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_tradeTable, 4, 12, "",           text_color=C_TXT_DIM,  bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_tradeTable, 5, 12, _dayPipsStr,  text_color=_dayPipsClr,bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_tradeTable, 6, 12, "",           text_color=C_TXT_DIM,  bgcolor=C_HEAD, text_size=_dashSz)

// ============================================================
// SECTION 19C — BEST MODEL TABLE
// ============================================================

if i_showBestModel
    if na(_bestTable)
        _bestTable := table.new(f_tablePos(i_bestModelPos), 4, 10,
             bgcolor       = color.new(#1A1D26, 10),
             border_color  = color.new(color.gray, 50),
             border_width  = 1,
             frame_color   = color.new(color.gray, 30),
             frame_width   = 1)

    // Header
    table.cell(_bestTable, 0, 0, "MODEL",  text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_bestTable, 1, 0, "WIN%",   text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_bestTable, 2, 0, "TRADES", text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)
    table.cell(_bestTable, 3, 0, "STREAK", text_color=C_TXT, bgcolor=C_HEAD, text_size=_headSz)

    _bmNames  = array.from("M1 Crabel","M3 5min","M4 15min","M6 FVG","M7 Gold","M9 FailORB","M10 BDM","Combined")
    _bmIdxs   = array.from(1, 3, 4, 6, 7, 9, 11, 10)

    _bestWR   = -1.0
    _bestName = ""
    _bestRow  = 0

    for _bi = 0 to 7
        [_bW, _bL, _bT] = f_winRate(array.get(_bmIdxs, _bi))
        _bWR    = _bT >= 1 ? float(_bW) / float(_bT) * 100.0 : -1.0
        _wrStr2 = _bT >= 1 ? str.tostring(math.round(_bWR)) + "%" : "-"
        _trStr  = _bT >= 1 ? str.tostring(_bT) : "0"
        _rowClr = _bT < 3  ? C_TXT_DIM :
                   _bWR >= 60 ? color.new(#00E676,0) :
                   _bWR >= 50 ? color.new(#FF9800,0) : color.new(#FF1744,0)
        _rowBG3 = C_NONE
        _bStrk  = array.get(_mStreak, array.get(_bmIdxs, _bi) - 1)
        _strkStr = _bStrk > 0 ? "W" + str.tostring(_bStrk) : _bStrk < 0 ? "L" + str.tostring(math.abs(_bStrk)) : "-"
        _strkClr = _bStrk > 0 ? color.new(#00E676,0) : _bStrk < 0 ? color.new(#FF1744,0) : C_TXT_DIM
        table.cell(_bestTable, 0, _bi + 1, array.get(_bmNames, _bi), text_color=_rowClr,  bgcolor=_rowBG3, text_size=_dashSz)
        table.cell(_bestTable, 1, _bi + 1, _wrStr2,                   text_color=_rowClr,  bgcolor=_rowBG3, text_size=_dashSz)
        table.cell(_bestTable, 2, _bi + 1, _trStr,                    text_color=_rowClr,  bgcolor=_rowBG3, text_size=_dashSz)
        table.cell(_bestTable, 3, _bi + 1, _strkStr,                  text_color=_strkClr, bgcolor=_rowBG3, text_size=_dashSz)
        if _bT >= 3 and _bWR > _bestWR
            _bestWR   := _bWR
            _bestName := array.get(_bmNames, _bi)
            _bestRow  := _bi + 1

    // Highlight best model row
    if _bestRow > 0
        _hStrk  = array.get(_mStreak, array.get(_bmIdxs, _bestRow - 1) - 1)
        _hStrkStr = _hStrk > 0 ? "W" + str.tostring(_hStrk) : _hStrk < 0 ? "L" + str.tostring(math.abs(_hStrk)) : "-"
        table.cell(_bestTable, 0, _bestRow, array.get(_bmNames, _bestRow - 1),
             text_color=color.new(#FFD600,0), bgcolor=color.new(#FFD600,85), text_size=_dashSz)
        table.cell(_bestTable, 1, _bestRow, str.tostring(math.round(_bestWR)) + "%",
             text_color=color.new(#FFD600,0), bgcolor=color.new(#FFD600,85), text_size=_dashSz)
        table.cell(_bestTable, 3, _bestRow, _hStrkStr,
             text_color=color.new(#FFD600,0), bgcolor=color.new(#FFD600,85), text_size=_dashSz)

    // Summary row
    _summBestStr = _bestName != "" ?
         "BEST: " + _bestName + " " + str.tostring(math.round(_bestWR)) + "%" :
         "BEST: Insufficient data"
    _summBestClr = _bestName != "" ? color.new(#FFD600,0) : C_TXT_DIM
    table.cell(_bestTable, 0, 9, _summBestStr, text_color=_summBestClr, bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_bestTable, 1, 9, "",           text_color=C_TXT_DIM,    bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_bestTable, 2, 9, "",           text_color=C_TXT_DIM,    bgcolor=C_HEAD, text_size=_dashSz)
    table.cell(_bestTable, 3, 9, "",           text_color=C_TXT_DIM,    bgcolor=C_HEAD, text_size=_dashSz)

// ============================================================
// SECTION 20 — OBJECT CLEANUP (keep under 490 per type)
// ============================================================

while array.size(_boxes)  > 490
    box.delete(array.shift(_boxes))
while array.size(_lines)  > 490
    line.delete(array.shift(_lines))
while array.size(_labels) > 490
    label.delete(array.shift(_labels))

// ============================================================
// SECTION 20B — TIMEFRAME GUARD
// Pine cannot sample a LOWER timeframe than the chart, so when the chart TF is
// higher than a configured reference TF, signals fall back to chart-bar closes
// (Section 4 routing). Surface that clearly instead of failing silently.
// ============================================================

var table _warnTable = na
_tfTooHigh = timeframe.in_seconds(timeframe.period) > timeframe.in_seconds(i_refTF) or timeframe.in_seconds(timeframe.period) > timeframe.in_seconds(i_refTF_fast)
if _tfTooHigh
    if na(_warnTable)
        _warnTable := table.new(position.top_center, 1, 1,
             bgcolor      = color.new(#B71C1C, 10),
             border_color = color.new(#FF8A80, 0),
             border_width = 1)
    table.cell(_warnTable, 0, 0,
         "⚠ Chart TF is HIGHER than a Reference TF (" + i_refTF + " / " + i_refTF_fast + " min) — signals fall back to chart-bar closes.\nFor intended behavior use a chart TF at or below the Fast Reference TF.",
         text_color=color.white, text_size=size.small)

// ============================================================
// SECTION 21 — plotshape (MUST be at global scope, Pine v6)
// ============================================================

// Model 1 — Classic Crabel
plotshape(sig_m1_bull and i_m1_on and _agreeCountBull >= i_minAgree,
     title="M1 Crabel — Long",  style=shape.triangleup,   location=location.belowbar,
     color=i_colBull,  size=size.small,  text="M1",  textcolor=color.white)
plotshape(sig_m1_bear and i_m1_on and _agreeCountBear >= i_minAgree,
     title="M1 Crabel — Short", style=shape.triangledown, location=location.abovebar,
     color=i_colBear,  size=size.small,  text="M1",  textcolor=color.white)

// Model 3 — 5-Min Scalper
plotshape(sig_m3_bull and i_m3_on and _agreeCountBull >= i_minAgree,
     title="M3 5min — Long",  style=shape.triangleup,   location=location.belowbar,
     color=color.new(#00BCD4,0), size=size.small, text="M3", textcolor=color.white)
plotshape(sig_m3_bear and i_m3_on and _agreeCountBear >= i_minAgree,
     title="M3 5min — Short", style=shape.triangledown, location=location.abovebar,
     color=color.new(#00BCD4,0), size=size.small, text="M3", textcolor=color.white)

// Model 4 — Standard 15-Min (larger arrow — reference model)
plotshape(sig_m4_bull and i_m4_on and _agreeCountBull >= i_minAgree,
     title="M4 15min — Long",  style=shape.arrowup,   location=location.belowbar,
     color=i_colBull,  size=size.normal, text="M4", textcolor=color.white)
plotshape(sig_m4_bear and i_m4_on and _agreeCountBear >= i_minAgree,
     title="M4 15min — Short", style=shape.arrowdown, location=location.abovebar,
     color=i_colBear,  size=size.normal, text="M4", textcolor=color.white)

// Model 6 — FVG ORB
plotshape(sig_m6_bull and i_m6_on and _agreeCountBull >= i_minAgree,
     title="M6 FVG — Long",  style=shape.diamond, location=location.belowbar,
     color=color.new(#E040FB,0), size=size.small, text="M6", textcolor=color.white)
plotshape(sig_m6_bear and i_m6_on and _agreeCountBear >= i_minAgree,
     title="M6 FVG — Short", style=shape.diamond, location=location.abovebar,
     color=color.new(#E040FB,0), size=size.small, text="M6", textcolor=color.white)

// Model 7 — Gold ORB
plotshape(sig_m7_bull and i_m7_on and _agreeCountBull >= i_minAgree,
     title="M7 Gold — Long",  style=shape.circle, location=location.belowbar,
     color=color.new(#FFD600,0), size=size.small, text="M7", textcolor=color.white)
plotshape(sig_m7_bear and i_m7_on and _agreeCountBear >= i_minAgree,
     title="M7 Gold — Short", style=shape.circle, location=location.abovebar,
     color=color.new(#FFD600,0), size=size.small, text="M7", textcolor=color.white)

// Model 9 — Failed ORB Reversal (no agreement gate — counter-consensus by design)
plotshape(sig_m9_bull and i_m9_on,
     title="M9 FailORB — Long",  style=shape.xcross, location=location.belowbar,
     color=i_colBull,  size=size.small, text="M9", textcolor=color.white)
plotshape(sig_m9_bear and i_m9_on,
     title="M9 FailORB — Short", style=shape.xcross, location=location.abovebar,
     color=i_colBear,  size=size.small, text="M9", textcolor=color.white)

// Model 10 — BDM ORB
plotshape(sig_m10_bull and i_m10_on and _agreeCountBull >= i_minAgree,
     title="M10 BDM — Long",  style=shape.triangleup,   location=location.belowbar,
     color=i_colBull, size=size.small, text="M10", textcolor=color.white)
plotshape(sig_m10_bear and i_m10_on and _agreeCountBear >= i_minAgree,
     title="M10 BDM — Short", style=shape.triangledown, location=location.abovebar,
     color=i_colBear, size=size.small, text="M10", textcolor=color.white)

// Combined Mode
plotshape(sig_comb_bull and i_comb_on,
     title="Combined — Long",  style=shape.arrowup,   location=location.belowbar,
     color=i_colBull,  size=size.large, text="ORB+", textcolor=color.white)
plotshape(sig_comb_bear and i_comb_on,
     title="Combined — Short", style=shape.arrowdown, location=location.abovebar,
     color=i_colBear,  size=size.large, text="ORB+", textcolor=color.white)

// ============================================================
// SECTION 22 — ALERT CONDITIONS (global scope, Pine v6)
// ============================================================

alertcondition(sig_m1_bull  and _agreeCountBull >= i_minAgree, title="M1 Crabel — LONG",               message="ORB M1 Crabel LONG | {{ticker}} | {{close}}")
alertcondition(sig_m1_bear  and _agreeCountBear >= i_minAgree, title="M1 Crabel — SHORT",              message="ORB M1 Crabel SHORT | {{ticker}} | {{close}}")
alertcondition(sig_m3_bull  and _agreeCountBull >= i_minAgree, title="M3 5min Scalper — LONG",         message="ORB M3 5min LONG | {{ticker}} | {{close}}")
alertcondition(sig_m3_bear  and _agreeCountBear >= i_minAgree, title="M3 5min Scalper — SHORT",        message="ORB M3 5min SHORT | {{ticker}} | {{close}}")
alertcondition(sig_m4_bull  and _agreeCountBull >= i_minAgree, title="M4 Standard 15-Min — LONG",      message="ORB M4 15min LONG | {{ticker}} | {{close}}")
alertcondition(sig_m4_bear  and _agreeCountBear >= i_minAgree, title="M4 Standard 15-Min — SHORT",     message="ORB M4 15min SHORT | {{ticker}} | {{close}}")
alertcondition(sig_m6_bull  and _agreeCountBull >= i_minAgree, title="M6 FVG ORB — LONG",              message="ORB M6 FVG LONG | {{ticker}} | {{close}}")
alertcondition(sig_m6_bear  and _agreeCountBear >= i_minAgree, title="M6 FVG ORB — SHORT",             message="ORB M6 FVG SHORT | {{ticker}} | {{close}}")
alertcondition(sig_m7_bull  and _agreeCountBull >= i_minAgree, title="M7 Gold ORB — LONG",             message="ORB M7 Gold LONG | {{ticker}} | {{close}}")
alertcondition(sig_m7_bear  and _agreeCountBear >= i_minAgree, title="M7 Gold ORB — SHORT",            message="ORB M7 Gold SHORT | {{ticker}} | {{close}}")
alertcondition(sig_m9_bull  and i_m9_on, title="M9 Failed ORB — LONG (Reversal)", message="ORB M9 FailORB LONG | {{ticker}} | {{close}}")
alertcondition(sig_m9_bear  and i_m9_on, title="M9 Failed ORB — SHORT (Reversal)",message="ORB M9 FailORB SHORT | {{ticker}} | {{close}}")
alertcondition(sig_m10_bull and _agreeCountBull >= i_minAgree, title="M10 BDM ORB — LONG",              message="ORB M10 BDM LONG | {{ticker}} | {{close}}")
alertcondition(sig_m10_bear and _agreeCountBear >= i_minAgree, title="M10 BDM ORB — SHORT",             message="ORB M10 BDM SHORT | {{ticker}} | {{close}}")
alertcondition(sig_comb_bull, title="Combined ORB+ — LONG",  message="ORB Combined LONG | {{ticker}} | {{close}}")
alertcondition(sig_comb_bear, title="Combined ORB+ — SHORT", message="ORB Combined SHORT | {{ticker}} | {{close}}")

// Catch-all
alertcondition(
     sig_comb_bull or
     ((sig_m1_bull or sig_m3_bull or sig_m4_bull or sig_m6_bull or sig_m7_bull or sig_m9_bull or sig_m10_bull) and _agreeCountBull >= i_minAgree),
     title="ANY ORB — LONG",  message="ORB Signal LONG | {{ticker}} | {{close}}")
alertcondition(
     sig_comb_bear or
     ((sig_m1_bear or sig_m3_bear or sig_m4_bear or sig_m6_bear or sig_m7_bear or sig_m9_bear or sig_m10_bear) and _agreeCountBear >= i_minAgree),
     title="ANY ORB — SHORT", message="ORB Signal SHORT | {{ticker}} | {{close}}")

alertcondition(sigEOD, title="EOD Exit — open trades closed", message="ORB EOD EXIT | {{ticker}} | {{close}}")

// ============================================================
// SECTION 23 — DYNAMIC alert() (once per bar close, with context)
// ============================================================

if _refEdge or _fastEdge
    // Pre-compute agree suffixes (M9 excluded — counter-consensus model)
    _agBull = " | agree:" + str.tostring(_agreeCountBull)
    _agBear = " | agree:" + str.tostring(_agreeCountBear)
    _tkr    = syminfo.ticker
    _ep     = str.tostring(close, format.mintick)

    if sig_m1_bull
        alert("ORB M1 Crabel LONG | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(true,  fast_close, fast_rvol, fast_vwap, fast_rsi14)) + _agBull, alert.freq_once_per_bar_close)
    if sig_m1_bear
        alert("ORB M1 Crabel SHORT | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(false, fast_close, fast_rvol, fast_vwap, fast_rsi14)) + _agBear, alert.freq_once_per_bar_close)
    if sig_m3_bull
        alert("ORB M3 5min Scalper LONG | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(true,  ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBull, alert.freq_once_per_bar_close)
    if sig_m3_bear
        alert("ORB M3 5min Scalper SHORT | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(false, ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBear, alert.freq_once_per_bar_close)
    if sig_m4_bull
        alert("ORB M4 15min Standard LONG | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(true,  ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBull, alert.freq_once_per_bar_close)
    if sig_m4_bear
        alert("ORB M4 15min Standard SHORT | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(false, ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBear, alert.freq_once_per_bar_close)
    if sig_m6_bull
        alert("ORB M6 FVG LONG | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(true,  ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBull, alert.freq_once_per_bar_close)
    if sig_m6_bear
        alert("ORB M6 FVG SHORT | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(false, ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBear, alert.freq_once_per_bar_close)
    if sig_m7_bull
        alert("ORB M7 Gold LONG | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(true,  ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBull, alert.freq_once_per_bar_close)
    if sig_m7_bear
        alert("ORB M7 Gold SHORT | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(false, ref_close, ref_rvol, ref_vwap, ref_rsi14)) + _agBear, alert.freq_once_per_bar_close)
    if sig_m9_bull
        alert("ORB M9 FailORB Reversal LONG | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(true,  ref_close, ref_rvol, ref_vwap, ref_rsi14)), alert.freq_once_per_bar_close)
    if sig_m9_bear
        alert("ORB M9 FailORB Reversal SHORT | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(false, ref_close, ref_rvol, ref_vwap, ref_rsi14)), alert.freq_once_per_bar_close)
    if sig_m10_bull
        alert("ORB M10 BDM LONG | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(true,  fast_close, fast_rvol, fast_vwap, ref_rsi14)) + _agBull, alert.freq_once_per_bar_close)
    if sig_m10_bear
        alert("ORB M10 BDM SHORT | " + _tkr + " | Entry: " + _ep + " | score:" + str.tostring(f_modelScore(false, fast_close, fast_rvol, fast_vwap, ref_rsi14)) + _agBear, alert.freq_once_per_bar_close)
    _dxyAlertSuffix = not _dxyActive ? "" :
         na(dxy_close) or na(dxy_ema20) ? " | DXY: N/A" :
         dxy_close < dxy_ema20          ? " | DXY: BEAR (Gold+)" : " | DXY: BULL (Gold-)"
    if sig_comb_bull
        alert("ORB Combined LONG | " + _tkr +
             " | Entry: " + _ep +
             " | Score: " + str.tostring(math.round(_confScore)) + "% [" + _confGrade + "]" +
             _dxyAlertSuffix,
             alert.freq_once_per_bar_close)
    if sig_comb_bear
        alert("ORB Combined SHORT | " + _tkr +
             " | Entry: " + _ep +
             " | Score: " + str.tostring(math.round(_confScore)) + "% [" + _confGrade + "]" +
             _dxyAlertSuffix,
             alert.freq_once_per_bar_close)

// EOD exit alert — independent of ref-TF edges
if sigEOD
    alert("ORB EOD EXIT | " + syminfo.ticker + " | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ============================================================
// SECTION 24 — BACKGROUND COLORING
// ============================================================

// Highlight OR windows
bgcolor(in15MinOR ? color.new(#2196F3, 92) : na, title="15-Min OR Window Highlight")
bgcolor(in5MinOR  ? color.new(#00BCD4, 88) : na, title="5-Min OR Window Highlight")

// Prime window highlight — gold tint on first 30 min of NY session
bgcolor(i_showPrimeWindow and _primeWindow ? color.new(#FFD600, 91) : na, title="Prime Window Highlight (9:30-10:00 NY)")

// News-spike cooldown — red tint while entries are blocked
bgcolor(i_newsGuard and not _newsOK ? color.new(#B71C1C, 88) : na, title="News Cooldown")

// Color bars with abnormally high RVOL
barcolor(rvol >= 2.0 ? color.new(#FF6F00, 0) : rvol >= 1.5 ? color.new(#F9A825, 30) : na,
     title="High RVOL Bars")

// ============================================================
// END OF INDICATOR
// ============================================================
